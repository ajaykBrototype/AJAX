

<!-- ══ MOBILE MENU ══ -->
<div id="mob-menu">
  <button id="mob-close">✕</button>
  <a href="/" class="mob-link">Home</a>
  <% if (locals.categories && locals.categories.length > 0) { %>
    <% locals.categories.forEach(function(cat) { %>
      <a href="/category/<%= cat.name %>" class="mob-link" style="text-transform: capitalize;"><%= cat.name %></a>
    <% }); %>
  <% } %>
</div>

<!-- ══ NAVBAR ══ -->
<nav id="navbar">
  <div style="max-width:1320px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;">
    <a href="/" class="logo">AJAX</a>

    <div class="hidden md:flex items-center gap-10" id="nav-links">
      <a href="/" class="nav-link">HOME</a>
      <% if (locals.categories && locals.categories.length > 0) { %>
        <% locals.categories.forEach(function(cat) { %>
          <a href="/category/<%= cat.name %>" class="nav-link" style="text-transform: uppercase;"><%= cat.name %></a>
        <% }); %>
      <% } %>
    </div>

    <div class="flex items-center gap-1">
      <button class="nav-icon" id="searchToggleBtn" title="Search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <a href="/wishlist" class="nav-icon flex relative" title="Wishlist">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span id="wishlist-count-badge" class="absolute -top-1.5 -right-1.5 bg-[#B04040] text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full <%= (locals.wishlistCount || 0) > 0 ? '' : 'hidden' %>">
          <%= locals.wishlistCount || 0 %>
        </span>
      </a>
      <a href="/cart" class="nav-icon flex relative" title="Cart">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span id="cart-count-badge" class="absolute -top-1.5 -right-1.5 bg-[#B04040] text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full <%= (locals.cartCount || 0) > 0 ? '' : 'hidden' %>">
          <%= locals.cartCount || 0 %>
        </span>
      </a>
      <div class="relative flex items-center">
        <% if (locals.user) { %>
          <button id="accountBtn" class="nav-icon" title="Account">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </button>
          <div id="accountDropdown" class="dropdown-menu">
            <div style="padding:1rem 1.15rem;border-bottom:1px solid var(--bdr);margin-bottom:0.4rem">
              <p style="font-size:0.52rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--stone);margin-bottom:0.35rem">Quick Access</p>
              <p style="font-family:'Playfair Display',serif;font-size:1.15rem;color:var(--dark);line-height:1.2;font-style:italic">My Account</p>
            </div>
            <a href="/profile" class="dropdown-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Overview
            </a>
            <a href="/address" class="dropdown-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Addresses
            </a>
            <a href="/orders" class="dropdown-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              My Orders
            </a>
            <a href="/wallet" class="dropdown-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
              Wallet
            </a>
            <div class="dropdown-divider"></div>
            <a href="/logout" class="dropdown-item" style="color:#B04040">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign out
            </a>
          </div>
        <% } else { %>
          <a href="/login" class="nav-icon" title="Sign In">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </a>
        <% } %>
      </div>
      <button id="ham" class="nav-icon md:hidden">
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none"><line x1="0" y1="1" x2="20" y2="1" stroke="currentColor" stroke-width="1.5"/><line x1="0" y1="7" x2="20" y2="7" stroke="currentColor" stroke-width="1.5"/><line x1="0" y1="13" x2="20" y2="13" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
    </div>
  </div>
</nav>

<!-- Search Overlay -->
<div id="searchOverlay" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.35);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:90px;">
  <div id="searchCard" style="width:100%;max-width:460px;margin:0 16px;">
    <div style="display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid #e0ddd8;border-radius:999px;padding:12px 18px;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9e9689" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="searchInput" type="text" placeholder="Search products, shirts, tops..." autocomplete="off"
        style="flex:1;border:none;outline:none;font-size:14px;font-family:inherit;background:transparent;color:#1C1C1C;letter-spacing:0.01em;">
      <button id="searchCloseBtn" style="background:none;border:none;cursor:pointer;color:#b0aa9f;display:flex;align-items:center;padding:0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="searchResults" style="display:none;background:#fff;border-radius:16px;margin-top:8px;box-shadow:0 8px 40px rgba(0,0,0,0.13);overflow:hidden;"></div>
  </div>
</div>

<script>
(function() {
  var toggleBtn  = document.getElementById('searchToggleBtn');
  var overlay    = document.getElementById('searchOverlay');
  var input      = document.getElementById('searchInput');
  var closeBtn   = document.getElementById('searchCloseBtn');
  var resultsBox = document.getElementById('searchResults');
  var debounceTimer = null;
  var lastQuery = '';

  function openSearch() {
    overlay.style.display = 'flex';
    setTimeout(function(){ input.focus(); }, 60);
  }
  function closeSearch() {
    overlay.style.display = 'none';
    input.value = '';
    resultsBox.style.display = 'none';
    resultsBox.innerHTML = '';
    lastQuery = '';
  }

  toggleBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    overlay.style.display === 'none' ? openSearch() : closeSearch();
  });
  closeBtn.addEventListener('click', closeSearch);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeSearch(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSearch(); });

  function renderResults(results, q) {
    if (!results.length) {
      resultsBox.innerHTML = '<div style="padding:20px 18px;font-size:13px;color:#999;text-align:center;">No results for &ldquo;<strong>' + q + '</strong>&rdquo;</div>';
      resultsBox.style.display = 'block';
      return;
    }
    var showViewAll = results.length > 3;
    var displayResults = results.slice(0, 3);
    var rows = displayResults.map(function(r) {
      var priceHtml = r.finalPrice
        ? '<span style="font-weight:600;color:#1C1C1C;">&#8377;' + r.finalPrice + '</span>&nbsp;<span style="text-decoration:line-through;color:#b0aa9f;font-size:11px;">&#8377;' + r.price + '</span>'
        : '<span style="color:#6b6660;">&#8377;' + r.price + '</span>';
      return '<a href="/product/' + r._id + '" style="display:flex;align-items:center;gap:14px;padding:12px 18px;border-bottom:1px solid #f3f1ee;text-decoration:none;color:inherit;" onmouseover="this.style.background=\'#faf9f7\'" onmouseout="this.style.background=\'transparent\'">'
        + '<div style="width:44px;height:56px;flex-shrink:0;border-radius:10px;overflow:hidden;background:#f5f3f0;"><img src="' + (r.image || '/fallback.png') + '" style="width:100%;height:100%;object-fit:cover;" loading="lazy"></div>'
        + '<div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:600;color:#1C1C1C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + r.name + '</div>'
        + '<div style="margin-top:4px;font-size:12px;">' + priceHtml + '</div></div>'
        + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c0bbb5" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>'
        + '</a>';
    }).join('');
    var viewAll = showViewAll ? '<a href="/men-product-list?search=' + encodeURIComponent(q) + '" style="display:flex;align-items:center;justify-content:center;gap:6px;padding:14px 18px;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#1C1C1C;text-decoration:none;background:#faf9f7;" onmouseover="this.style.background=\'#f2f0ec\'" onmouseout="this.style.background=\'#faf9f7\'">View All Results <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg></a>' : '';
    resultsBox.innerHTML = rows + viewAll;
    resultsBox.style.display = 'block';
  }

  input.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    var q = input.value.trim();
    if (!q) { resultsBox.style.display = 'none'; resultsBox.innerHTML = ''; lastQuery = ''; return; }
    if (q === lastQuery) return;
    debounceTimer = setTimeout(function() {
      lastQuery = q;
      fetch('/api/search?q=' + encodeURIComponent(q))
        .then(function(r){ return r.json(); })
        .then(function(data){ if (data.success) renderResults(data.results, q); })
        .catch(function(){});
    }, 350);
  });
})();
</script>

<script>
/* Navbar: Mobile menu */
document.getElementById('ham').addEventListener('click', () => {
  document.getElementById('mob-menu').classList.add('open');
});
document.getElementById('mob-close').addEventListener('click', () => {
  document.getElementById('mob-menu').classList.remove('open');
});

/* Navbar: Account Dropdown */
const accBtn = document.getElementById('accountBtn');
const accDrop = document.getElementById('accountDropdown');
if (accBtn && accDrop) {
  accBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    accDrop.classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    if (!accDrop.contains(e.target) && !accBtn.contains(e.target)) {
      accDrop.classList.remove('open');
    }
  });
}

document.addEventListener('keydown', e => {
  if (e.key !== 'Escape') return;
  document.getElementById('mob-menu').classList.remove('open');
  if (accDrop) accDrop.classList.remove('open');
});
</script>
<script src="/js/utils/btn-loader.js"></script>
<script src="/js/utils/page-loader.js"></script>
