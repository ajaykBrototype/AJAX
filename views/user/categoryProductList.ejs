<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AJAX — <%= targetCategory.name %></title>
<script src="https://cdn.tailwindcss.com"></script>
<!-- Add GSAP for animations -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
tailwind.config = {
  theme: { 
    extend: { 
      fontFamily: { 
        serif: ['Playfair Display', 'serif'], 
        sans: ['Inter', 'sans-serif'] 
      } 
    } 
  }
}
</script>
<%- include('../partials/navbar-styles') %>
<style>
/* CORE LUXURY STYLES */
body {
    background-color: #F9F9F7; /* Very subtle luxury cream */
    color: #1A1A1A;
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
}

/* ANIMATIONS */
.fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
@keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

@keyframes gentleSwing {
    0% { transform: rotate(0deg); }
    25% { transform: rotate(1.5deg); }
    50% { transform: rotate(-1deg); }
    75% { transform: rotate(0.5deg); }
    100% { transform: rotate(0deg); }
}

/* Scroll reveal class */
.sr {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.sr.in {
    opacity: 1;
    transform: translateY(0);
}

/* HANGER DISPLAY EFFECT */
.product-card:hover .hanger-swing {
    transform-origin: top center;
    animation: gentleSwing 2s ease-in-out forwards;
}

/* SEARCH BAR INTERACTION */
.search-container input {
    width: 0;
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.search-container:hover input,
.search-container input:focus,
.search-container input:not(:placeholder-shown) {
    width: 200px;
    opacity: 1;
}

/* CUSTOM SORT DROPDOWN */
.custom-sort-dropdown { position: relative; }
.sort-dropdown-menu {
    position: absolute;
    top: 100%; right: 0;
    margin-top: 12px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 1.5rem;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1);
    padding: 12px;
    z-index: 100;
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 200px;
}
.sort-dropdown-menu.show {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
}
.sort-dropdown-item {
    padding: 12px 20px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    cursor: pointer;
    border-radius: 1rem;
    transition: all 0.2s ease;
}
.sort-dropdown-item:hover { background: #F5F1EB; }
.sort-dropdown-item.active { background: #1A1A1A; color: white; }

/* SIDEBAR FILTER (Unchanged Logic, Upgraded UI) */
.filter-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.2); backdrop-filter: blur(4px);
    z-index: 100; opacity: 0; pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.filter-sidebar {
    position: fixed; top: 0; right: 0;
    width: 100%; max-width: 400px; height: 100%;
    background: #F9F9F7;
    z-index: 101; transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex; flex-direction: column;
    box-shadow: -15px 0 50px rgba(0,0,0,0.05);
}
.sidebar-open .filter-overlay { opacity: 1; pointer-events: auto; }
.sidebar-open .filter-sidebar { transform: translateX(0); }

.filter-pill {
    padding: 0.8rem 1.2rem;
    border: 1px solid rgba(26,26,26,0.1);
    border-radius: 2rem;
    font-size: 0.6rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    transition: all 0.3s; cursor: pointer; text-align: center;
}
.filter-pill:hover { border-color: #1A1A1A; }
.filter-pill.active { background: #1A1A1A; color: #fff; border-color: #1A1A1A; }

/* DUAL RANGE SLIDER */
.price-range-slider-container { position: relative; width: 100%; height: 30px; margin-top: 10px; }
.price-range-slider-container input[type="range"] {
    position: absolute; width: 100%; pointer-events: none; -webkit-appearance: none; background: none; height: 2px; top: 50%; transform: translateY(-50%); margin: 0;
}
.price-range-slider-container input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; pointer-events: all; width: 16px; height: 16px; background: #1A1A1A; border-radius: 50%; cursor: pointer; position: relative; z-index: 10;
}
.price-track { position: absolute; width: 100%; height: 2px; background: rgba(0,0,0,0.1); top: 50%; transform: translateY(-50%); z-index: 1; }
.price-range-highlight { position: absolute; height: 2px; background: #1A1A1A; top: 50%; transform: translateY(-50%); z-index: 2; }
</style>
<%- include('../partials/footer-styles') %>
</head>
<body>

<%- include('../partials/navbar') %>

<!-- 1. COMPACT CINEMATIC HERO HEADER -->
<div class="relative w-full py-6 md:py-8 flex items-center justify-center overflow-hidden mb-6 mt-10">
    <!-- Luxury ambient background -->
    <div class="absolute inset-0 bg-[#F5F1EB] -z-20">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#EAE4DC]/60 to-[#F5F1EB] -z-10"></div>
        <!-- Very subtle noise texture overlay -->
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSIvPjwvc3ZnPg==')] opacity-40 mix-blend-overlay"></div>
    </div>
    
    <div class="relative z-10 text-center flex flex-col items-center px-4 w-full">

        <div class="fade-in-up delay-1 overflow-hidden px-4">
            <h1 class="font-serif italic text-4xl md:text-5xl lg:text-6xl text-[#1A1A1A] tracking-tight leading-[1.1] capitalize">
                <%= targetCategory.name %> <span class="not-italic font-normal">Collection</span>
            </h1>
        </div>
        <p class="fade-in-up delay-2 text-[0.55rem] uppercase tracking-[0.3em] text-[#B89D7A] font-bold mt-3">
            Designed for timeless elegance.
        </p>
    </div>
</div>

<main class="max-w-[1536px] mx-auto">
    <!-- 2. CATEGORY CAPSULE TABS -->
    <div class="flex flex-wrap gap-3 justify-center mb-10 fade-in-up delay-2 px-6">
        <a href="/category/<%= targetCategory.name %>" class="relative px-5 py-2.5 text-[0.55rem] font-bold tracking-[0.15em] uppercase transition-colors duration-300 rounded-full group <%= !selectedSub ? 'text-white' : 'text-[#1A1A1A] hover:bg-black/5' %>">
            <span class="relative z-10">All Essentials</span>
            <% if (!selectedSub) { %>
                <div class="absolute inset-0 bg-[#1A1A1A] rounded-full -z-10 shadow-md"></div>
            <% } %>
        </a>
        <% subCategories.forEach(sub => { %>
            <a href="/category/<%= targetCategory.name %>?sub=<%= sub._id %>" class="relative px-5 py-2.5 text-[0.55rem] font-bold tracking-[0.15em] uppercase transition-colors duration-300 rounded-full group <%= selectedSub == sub._id.toString() ? 'text-white' : 'text-[#1A1A1A] hover:bg-black/5' %>">
                <span class="relative z-10"><%= sub.name %></span>
                <% if (selectedSub == sub._id.toString()) { %>
                    <div class="absolute inset-0 bg-[#1A1A1A] rounded-full -z-10 shadow-md"></div>
                <% } %>
            </a>
        <% }) %>
    </div>

    <!-- 3. PREMIUM FLOATING TOOLBAR (COMPACT) -->
    <div class="sticky top-[70px] z-40 px-4 md:px-8 mb-10 fade-in-up delay-3">
        <div class="flex items-center justify-between py-3 px-5 md:px-6 bg-white/80 backdrop-blur-xl border border-white rounded-full shadow-[0_10px_30px_-10px_rgba(0,0,0,0.08)] mx-auto max-w-[1440px]">
            <!-- Filter Toggle -->
            <button class="flex items-center gap-2 text-[0.6rem] font-bold tracking-[0.15em] uppercase hover:text-[#B89D7A] transition-colors" onclick="toggleSidebar(true)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                <span>Refine</span>
            </button>
            
            <div class="flex items-center gap-4">
                <!-- Search Expansion -->
                <div class="search-container flex items-center gap-2 relative">
                    <input type="text" id="toolbarSearch" placeholder="Search Collection..." class="bg-transparent border-b border-transparent text-[#1A1A1A] text-[0.6rem] font-bold tracking-widest uppercase pb-0.5 placeholder-gray-400">
                    <button id="toolbarSearchBtn" class="hover:text-[#B89D7A] transition-colors" onclick="triggerToolbarSearch()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </button>
                </div>
                
                <div class="hidden md:block h-3 w-px bg-gray-300"></div>
                
                <!-- Sort Dropdown -->
                <div class="relative custom-sort-dropdown" id="sortDropdownContainer">
                    <button type="button" class="flex items-center gap-1.5 text-[0.6rem] font-bold tracking-[0.15em] uppercase hover:text-[#B89D7A] transition-colors" id="sortTrigger">
                        <span id="currentSortLabel">Sort By</span>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300" id="sortArrow"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="sort-dropdown-menu" id="sortMenu">
                        <div class="sort-dropdown-item active" data-value="newest">Newest Arrivals</div>
                        <div class="sort-dropdown-item" data-value="price-low">Price: Low - High</div>
                        <div class="sort-dropdown-item" data-value="price-high">Price: High - Low</div>
                        <div class="sort-dropdown-item" data-value="name-az">A - Z</div>
                        <div class="sort-dropdown-item" data-value="name-za">Z - A</div>
                    </div>
                    <input type="hidden" id="sortSelect" value="newest">
                </div>
            </div>
        </div>
    </div>

    <!-- 4. HANGER STYLE PRODUCT GRID -->
    <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12 px-4 md:px-8 max-w-[1440px] mx-auto pb-24 relative z-10">
        <% if (products.length > 0) { %>
            <% products.forEach((product, index) => { %>
                <% const variant = product.variants?.[0]; %>
                <div class="product-card group relative sr" style="transition-delay: <%= (index % 4) * 0.05 %>s">
                    <!-- Floating Wishlist -->
                    <button class="absolute top-3 right-3 z-20 w-8 h-8 rounded-full bg-white/80 backdrop-blur-md flex items-center justify-center opacity-0 transform scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-400 ease-out shadow hover:bg-[#1A1A1A] hover:text-white <%= wishlist.includes(product._id.toString()) ? 'text-red-500 opacity-100 scale-100' : 'text-[#1A1A1A]' %>" onclick="toggleWishlist('<%= product._id %>', this, '<%= variant?._id %>')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= wishlist.includes(product._id.toString()) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </button>
                    
                    <a href="/product/<%= product._id %>" class="block h-full flex flex-col hanger-swing">
                        <!-- Immersive Showroom Display -->
                        <div class="relative w-full aspect-[3/4] bg-[#EAE4DC] rounded-[1rem] overflow-hidden mb-4 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.05)] group-hover:shadow-[0_20px_40px_-10px_rgba(0,0,0,0.15)] group-hover:-translate-y-2 transition-all duration-500 cubic-bezier(0.16,1,0.3,1)">
                            
                            <!-- Minimal Top Hanger Detail Line -->
                            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-b from-black/5 to-transparent z-10"></div>
                            
                            <!-- Primary Image -->
                            <img src="<%= variant?.images?.[0] %>" class="primary-img absolute inset-0 w-full h-full object-cover transition-all duration-[1s] ease-out group-hover:scale-105 group-hover:opacity-0" alt="<%= product.name %>" />
                            
                            <!-- Secondary Lifestyle Image -->
                            <% if(variant?.images?.[1]) { %>
                                <img src="<%= variant.images[1] %>" class="secondary-img absolute inset-0 w-full h-full object-cover opacity-0 scale-105 transition-all duration-[0.8s] ease-out group-hover:opacity-100 group-hover:scale-100" alt="<%= product.name %>" />
                            <% } %>
                            
                            <!-- Glassmorphism Quick Add Overlay -->
                            <div class="absolute bottom-3 inset-x-3 bg-white/95 backdrop-blur-xl rounded-[0.75rem] py-2.5 text-center transform translate-y-[150%] opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-400 cubic-bezier(0.16,1,0.3,1)">
                                <span class="text-[0.55rem] font-bold tracking-[0.2em] uppercase text-[#1A1A1A]">View Details</span>
                            </div>
                        </div>
                        
                        <!-- Minimal Info Panel -->
                        <div class="text-center px-2 flex-grow flex flex-col justify-between transform transition-transform duration-300 group-hover:-translate-y-1">
                            <h3 class="text-[0.65rem] font-bold tracking-[0.1em] uppercase text-[#1A1A1A] mb-1.5 leading-snug"><%= product.name %></h3>
                            <p class="text-[0.75rem] font-serif italic text-gray-500">
                                <% if(product.offer) { %>
                                    <span class="text-[#1A1A1A] font-medium not-italic">₹<%= Math.round(product.finalPrice) %></span>
                                    <span class="line-through ml-2 opacity-40">₹<%= variant?.price %></span>
                                <% } else { %>
                                    ₹<%= variant?.price %>
                                <% } %>
                            </p>
                        </div>
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full py-20 text-center">
                <p class="text-[0.6rem] font-bold tracking-[0.2em] uppercase text-gray-400">The showroom is currently empty.</p>
            </div>
        <% } %>
    </div>

    <!-- 5. PAGINATION -->
    <div class="mt-12 mb-24 flex flex-col items-center justify-center relative z-10 sr">
        <div class="flex items-center gap-2 text-[0.8rem] font-medium">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %><%= selectedSub ? '&sub=' + selectedSub : '' %>" class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-black/5 transition-colors"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></a>
            <% } %>
            
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %><%= selectedSub ? '&sub=' + selectedSub : '' %>" class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 <%= currentPage === i ? 'bg-[#1A1A1A] text-white shadow-md' : 'hover:bg-black/5 text-gray-500' %>"><%= i %></a>
            <% } %>
            
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %><%= selectedSub ? '&sub=' + selectedSub : '' %>" class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-black/5 transition-colors"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            <% } %>
        </div>
        <div class="mt-8 h-px w-24 bg-gray-200"></div>
        <p class="text-[0.55rem] tracking-[0.25em] text-gray-400 mt-6 uppercase font-bold">Showing <%= products.length %> of <%= totalProducts %> Products</p>
    </div>
</main>

<!-- 6. SIDEBAR FILTER OVERLAY -->
<div class="filter-overlay" onclick="toggleSidebar(false)"></div>
<aside class="filter-sidebar">
    <div class="flex items-center justify-between p-8 border-b border-[rgba(0,0,0,0.05)]">
        <h2 class="text-2xl font-serif italic text-[#1A1A1A]">Refine Selection</h2>
        <button onclick="toggleSidebar(false)" class="p-2 hover:bg-black/5 rounded-full transition-colors"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    </div>
    
    <div class="flex-grow overflow-y-auto p-8 space-y-10 hide-scroll">
        <!-- Search -->
        <section>
            <span class="text-[0.6rem] font-bold tracking-[0.2em] text-gray-400 uppercase mb-4 block">Search</span>
            <div class="relative">
                <input type="text" id="sidebarSearch" placeholder="e.g. Linen Shirt..." class="w-full bg-white border border-[rgba(0,0,0,0.1)] rounded-2xl px-5 py-4 text-[0.7rem] font-medium placeholder:text-gray-300 focus:border-[#1A1A1A] outline-none transition-all shadow-sm">
            </div>
        </section>
        
        <!-- Sort -->
        <section>
            <span class="text-[0.6rem] font-bold tracking-[0.2em] text-gray-400 uppercase mb-4 block">Sort Options</span>
            <div class="grid grid-cols-2 gap-3">
                <button class="filter-pill sort-pill" data-sort="newest">Latest Drop</button>
                <button class="filter-pill sort-pill" data-sort="price-low">Price Low - High</button>
                <button class="filter-pill sort-pill" data-sort="price-high">Price High - Low</button>
                <button class="filter-pill sort-pill" data-sort="name-az">Name A - Z</button>
                <button class="filter-pill sort-pill" data-sort="name-za">Name Z - A</button>
            </div>
        </section>
        
        <!-- Category -->
        <section>
            <span class="text-[0.6rem] font-bold tracking-[0.2em] text-gray-400 uppercase mb-4 block">Categories</span>
            <div class="grid grid-cols-2 gap-3">
                <button class="filter-pill cat-pill" data-cat="">All Essentials</button>
                <% subCategories.forEach(sub => { %>
                    <button class="filter-pill cat-pill" data-cat="<%= sub._id %>"><%= sub.name %></button>
                <% }) %>
            </div>
        </section>
        
        <!-- Price -->
        <section>
            <span class="text-[0.6rem] font-bold tracking-[0.2em] text-gray-400 uppercase mb-4 block">Price Point</span>
            <div class="flex justify-between text-[0.65rem] font-bold text-gray-500 mb-4">
                <span id="minPriceLabel">₹0</span>
                <span id="maxPriceLabel">₹10000</span>
            </div>
            <div class="price-range-slider-container">
                <div class="price-track"></div>
                <div class="price-range-highlight" id="priceHighlight"></div>
                <input type="range" id="minPriceRange" min="0" max="10000" step="100" value="0">
                <input type="range" id="maxPriceRange" min="0" max="10000" step="100" value="10000">
            </div>
        </section>
    </div>
    
    <div class="p-8 bg-white border-t border-[rgba(0,0,0,0.05)] flex gap-4">
        <button onclick="clearAllFilters()" class="flex-1 py-4 border border-[rgba(0,0,0,0.1)] rounded-2xl text-[0.6rem] font-bold tracking-[0.15em] uppercase hover:bg-black/5 transition-colors text-[#1A1A1A]">Clear All</button>
        <button onclick="applyFilters()" class="flex-[2] py-4 bg-[#1A1A1A] rounded-2xl text-white text-[0.6rem] font-bold tracking-[0.15em] uppercase hover:bg-black transition-colors shadow-lg shadow-black/20">Apply Filters</button>
    </div>
</aside>

<%- include('../partials/footer') %>

<script>
/* Scroll Reveal Interactions */
document.addEventListener('DOMContentLoaded', () => {
    const obs = new IntersectionObserver(es => {
        es.forEach(e => {
            if(e.isIntersecting){
                e.target.classList.add('in');
                obs.unobserve(e.target);
            }
        });
    }, { threshold: 0.05, rootMargin: '0px 0px -50px 0px' });
    
    document.querySelectorAll('.sr').forEach(el => obs.observe(el));
});
</script>

<script src="https://unpkg.com/lucide@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/utils/swal-helper.js"></script>
<script src="/js/user/filter.js"></script>
<script src="/js/user/wishlist.js"></script>
<script>
  // Custom Sort Dropdown Logic
  const sortTrigger = document.getElementById('sortTrigger');
  const sortMenu = document.getElementById('sortMenu');
  const sortArrow = document.getElementById('sortArrow');
  const currentSortLabel = document.getElementById('currentSortLabel');
  const sortItems = document.querySelectorAll('.sort-dropdown-item');
  const sortInput = document.getElementById('sortSelect');

  sortTrigger.addEventListener('click', (e) => {
    e.stopPropagation();
    sortMenu.classList.toggle('show');
    sortArrow.classList.toggle('rotate-180');
  });

  document.addEventListener('click', () => {
    sortMenu.classList.remove('show');
    sortArrow.classList.remove('rotate-180');
  });

  sortItems.forEach(item => {
    item.addEventListener('click', () => {
      const value = item.getAttribute('data-value');
      const label = item.innerText;

      // Update Label and State
      currentSortLabel.innerText = label;
      window.filters.sort = value;
      
      // Update Active State
      sortItems.forEach(i => i.classList.remove('active'));
      item.classList.add('active');

      // Trigger Filtering
      if (typeof applyFilters === 'function') {
        applyFilters();
      }
    });
  });
</script>
</body>
</html>