<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signup | AJAX</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['Playfair Display', 'serif'],
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body { font-family: 'Inter', sans-serif; background-color: #ffffff; }
    .premium-input {
      background: transparent;
      border: none;
      border-bottom: 1px solid #d1d1d1;
      border-radius: 0;
      padding: 12px 0;
      transition: all 0.3s ease;
    }
    .premium-input:focus {
      outline: none;
      border-bottom-color: #000;
      box-shadow: none;
    }
    .stagger-item { opacity: 0; transform: translateY(20px); }
    
    /* Custom Scrollbar for overflow handling */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #e5e5e5; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #d4d4d4; }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body class="min-h-screen flex overflow-hidden bg-white">

  <!-- LEFT IMAGE -->
  <div class="hero-container hidden md:block w-7/12 h-screen overflow-hidden bg-white">
    <img 
      id="hero-img"
      src="/images/login3.png" 
      class="w-full h-full object-contain"
    />
  </div>

  <!-- RIGHT FORM -->
  <div class="right-panel w-full md:w-5/12 flex items-center justify-center bg-white relative h-screen overflow-y-auto">
    
    <!-- Outer wrapper to center content while allowing scrolling -->
    <div class="w-full min-h-full py-12 px-8 md:px-12 lg:px-20 flex flex-col justify-center">

      <!-- Back to Home Button -->
      <a href="/home" class="absolute top-8 right-8 text-[0.65rem] tracking-[0.2em] uppercase text-gray-400 hover:text-black transition-colors duration-300 flex items-center gap-2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Store
      </a>

      <div class="w-full max-w-sm mx-auto">
        <!-- Logo -->
        <a href="/home" class="stagger-item inline-block mb-12">
          <h1 class="text-xl font-bold tracking-[0.4em] uppercase">AJAX</h1>
        </a>

        <!-- Header -->
        <div class="mb-10">
          <h2 class="font-serif italic text-4xl mb-3 stagger-item">Create Account</h2>
          <p class="text-[0.65rem] tracking-[0.2em] uppercase text-gray-400 stagger-item">Join the community — it's free forever</p>
        </div>

        <!-- FORM -->
        <form id="signupForm" class="space-y-6">

          <!-- NAME -->
          <div class="stagger-item">
            <label class="text-[0.6rem] uppercase tracking-[0.2em] text-gray-400 mb-1 block">Full Name</label>
            <input type="text" name="name" placeholder="John Doe"
              class="w-full premium-input text-sm" />
            <p id="nameError" class="text-red-500 text-[0.65rem] mt-1 hidden"></p>
          </div>

          <!-- EMAIL -->
          <div class="stagger-item">
            <label class="text-[0.6rem] uppercase tracking-[0.2em] text-gray-400 mb-1 block">Email Address</label>
            <input type="email" name="email" placeholder="email@example.com"
              class="w-full premium-input text-sm" />
            <p id="emailError" class="text-red-500 text-[0.65rem] mt-1 hidden"></p>
          </div>

          <!-- PASSWORD -->
          <div class="stagger-item">
            <label class="text-[0.6rem] uppercase tracking-[0.2em] text-gray-400 mb-1 block">Password</label>
            <div class="relative">
              <input type="password" name="password" id="password"
                class="w-full premium-input text-sm pr-10" placeholder="••••••••" />
              <span 
                class="absolute right-0 top-3 cursor-pointer text-sm grayscale opacity-70 hover:opacity-100 transition-opacity"
                onclick="togglePassword('password', this)"
              >👁️</span>
            </div>
            <p id="passwordError" class="text-red-500 text-[0.65rem] mt-1 hidden"></p>
          </div>

          <!-- CONFIRM PASSWORD -->
          <div class="stagger-item">
            <label class="text-[0.6rem] uppercase tracking-[0.2em] text-gray-400 mb-1 block">Confirm Password</label>
            <div class="relative">
              <input type="password" name="confirmPassword" id="confirmPassword"
                class="w-full premium-input text-sm pr-10" placeholder="••••••••" />
              <span 
                class="absolute right-0 top-3 cursor-pointer text-sm grayscale opacity-70 hover:opacity-100 transition-opacity"
                onclick="togglePassword('confirmPassword', this)"
              >👁️</span>
            </div>
            <p id="confirmPasswordError" class="text-red-500 text-[0.65rem] mt-1 hidden"></p>
          </div>

          <!-- REFERRAL TOGGLE (Smaller) -->
          <div class="stagger-item space-y-4 pt-2">
            <div class="flex items-center gap-3">
              <button
                type="button"
                id="referralToggle"
                class="relative w-11 h-5 rounded-full bg-[#2B1A10] transition-colors duration-300 focus:outline-none"
              >
                <div
                  id="toggleCircle"
                  class="absolute top-[2px] left-[2px] w-4 h-4 bg-white rounded-full shadow-sm transition-transform duration-300"
                ></div>
              </button>
              <span class="text-[0.7rem] uppercase tracking-[0.15em] text-gray-500">
                I have a referral code
              </span>
            </div>

            <div
              id="referralWrapper"
              class="hidden opacity-0 translate-y-2 transition-all duration-300"
            >
              <div class="relative">
                <input
                  type="text"
                  name="referralCode"
                  placeholder="Enter Referral Code"
                  class="w-full premium-input text-sm pr-8"
                >
                <p id="referralCodeError"  class="hidden text-red-500 text-xs mt-2"></p>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="absolute right-0 top-[14px] w-4 h-4 text-gray-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20 12V8a2 2 0 0 0-2-2h-3V4a2 2 0 1 0-4 0v2H8a2 2 0 0 0-2 2v4m14 0v6a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-6m14 0H6"
                  />
                </svg>
              </div>
            </div>
          </div>

          <div class="stagger-item pt-4">
            <button id="signupBtn" class="w-full bg-black flex justify-center items-center gap-3 text-white py-4 text-[0.7rem] tracking-[0.3em] uppercase hover:bg-gray-900 transition-all duration-300 transform hover:scale-[1.01] active:scale-[0.98]">
              <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="btnText">Create Account</span>
            </button>
          </div>

        </form>
        
        <p class="stagger-item text-[0.7rem] text-gray-400 mt-10 text-center">
          Already have an account? 
          <a href="/login" class="text-black font-semibold underline underline-offset-4 hover:opacity-70 transition-opacity">Sign In</a>
        </p>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    // GSAP ANIMATIONS
    window.addEventListener('DOMContentLoaded', () => {
      const tl = gsap.timeline();

      // Initial States for refined entrance
      gsap.set('#hero-img', { scale: 1.05, opacity: 0 });
      gsap.set('.right-panel', { x: 20, opacity: 0 });

      tl.to('#hero-img', {
        scale: 1,
        opacity: 1,
        duration: 1.5,
        ease: 'power4.out'
      })
      .to('.right-panel', {
        x: 0,
        opacity: 1,
        duration: 1.2,
        ease: 'power3.out'
      }, "-=1")
      .to('.stagger-item', {
        opacity: 1,
        y: 0,
        stagger: 0.08,
        duration: 0.8,
        ease: 'power2.out'
      }, "-=0.8");

      // Subtle Dynamic Parallax on Mouse Move
      const heroImg = document.querySelector('#hero-img');
      document.addEventListener('mousemove', (e) => {
        if(window.innerWidth < 768) return; // Only on desktop
        const { clientX, clientY } = e;
        const xPos = (clientX / window.innerWidth - 0.5) * 15;
        const yPos = (clientY / window.innerHeight - 0.5) * 15;

        gsap.to(heroImg, {
          x: xPos,
          y: yPos,
          duration: 1.5,
          ease: 'power2.out'
        });
      });
    });
  </script>

  <script src="/js/user/signup.js"></script>
  <script src="/js/utils/swal-helper.js"></script>
</body>
</html>
