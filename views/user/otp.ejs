<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>OTP</title>

  <script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- 2. Then your helper -->
<script src="/js/utils/swal-helper.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body class="min-h-screen flex overflow-hidden">

  <!-- LEFT IMAGE -->
  <div class="hidden md:block w-1/2 h-screen">
    <img 
      src="/images/otp.jpg"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- RIGHT SIDE -->
  <div class="w-full md:w-1/2 flex items-center justify-center bg-[#f5f2ed]">

    <div class="w-full max-w-md p-8">

      <h1 class="text-xl font-semibold mb-6">AJAX</h1>

      <h2 class="text-3xl font-bold mb-2">Verify your email</h2>
      <p class="text-gray-500 mb-6">
        Enter the 6-digit code sent to your email
      </p>

      <!-- OTP BOXES -->
      <div id="otpContainer"  class="flex gap-2 mb-6 justify-between">
        <input maxlength="1" class="otp-box" />
        <input maxlength="1" class="otp-box" />
        <input maxlength="1" class="otp-box" />
        <input maxlength="1" class="otp-box" />
        <input maxlength="1" class="otp-box" />
        <input maxlength="1" class="otp-box" />
      </div>
      <p id="otpError" class="text-red-500 text-sm mt-2 hidden"></p>

      <!-- BUTTON -->
      <button id="verifyBtn" onclick="verifyOtp()" 
        class="w-full bg-black flex justify-center items-center gap-3 text-white py-3 rounded-lg hover:opacity-90 transition-all duration-300">
        <svg id="verifySpinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span id="verifyText">VERIFY CODE &rarr;</span>
      </button>

      <!-- RESEND -->
      <div class="flex justify-between mt-4 text-sm text-gray-400">
        <span id="timer">Resend code in 60s</span>
        <button id="resendBtn" onclick="resendOtp()" class="text-black font-semibold">
          RESEND
        </button>
      </div>

    </div>

  </div>

<!-- STYLE -->
<style>
.otp-box {
  width: 45px;
  height: 50px;
  text-align: center;
  font-size: 20px;
  border: 1px solid #ccc;
  border-radius: 8px;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/utils/swal-helper.js"></script>
  <script src="/js/user/otp.js"></script>
</body>
</html>
