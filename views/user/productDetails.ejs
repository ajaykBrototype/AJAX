<div class="review-modal-overlay" id="sizeGuideModal">
    <div class="review-modal-card" style="width: 480px; padding: 40px;">
        <div class="modal-header" style="margin-bottom: 24px;">
            <h3 class="modal-title" style="font-size: 20px; letter-spacing: 0.1em; text-transform: uppercase; text-align: center; width: 100%;">Size Guide</h3>
            <button type="button" class="modal-close-btn" id="sizeModalCloseBtn" style="position: absolute; right: 24px; top: 24px;">
