                    <tr style="background: #F4F4F5; border-bottom: 1px solid #E4E4E7;">
                        <th style="padding: 16px 12px; font-weight: 700; letter-spacing: 0.05em;">SIZE</th>
                        <th style="padding: 16px 12px; font-weight: 700; letter-spacing: 0.05em;">LENGTH</th>
