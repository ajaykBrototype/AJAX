<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title><%= (typeof product !== 'undefined' && product) ? product.name + ' — AJAX' : 'Sky Linen Shirt — AJAX' %></title>
    
    <!-- Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@200;300;400;500;700;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { serif: ['Playfair Display','serif'], sans: ['DM Sans','sans-serif'] } } }
        }
    </script>
    
    <!-- Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Animation Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    
    <%- include('../partials/navbar-styles') %>
<%- include('../partials/footer-styles') %>
<style>
        
        :root {
            --bg-color: #FFFFFF; 
            --surface-color: #F9F9F8;
            --text-primary: #121212;
            --text-secondary: #4A4A4A;
            --text-muted: #8E8E8E;
            --border-color: rgba(0,0,0,0.06);
            --accent-color: #000000;
            --font-main: 'DM Sans', sans-serif;
            --font-serif: 'Playfair Display', serif;
        }

        
        /* --- Main Layout --- */
        main {
            padding-top: 100px; 
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 80px;
            padding-left: 40px;
            padding-right: 40px;
            align-items: start;
        }

        /* --- Product Images Section --- */
        .product-images {
            display: grid;
            grid-template-columns: 80px 1fr;
            gap: 20px;
            align-items: start;
        }

        .main-image-column {
            min-width: 0;
        }

        .thumbnail-strip {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 80px;
            flex-shrink: 0;
        }

        .thumbnail {
            width: 70px;
            height: 94px;
            background: var(--surface-color);
            cursor: pointer;
            overflow: hidden;
            border-radius: 6px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid transparent;
        }

        .thumbnail.active-thumb {
            border-color: var(--accent-color);
        }

        .thumbnail:hover {
            transform: scale(1.02);
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .main-image-container {
            width: 100%;
            aspect-ratio: 0.82;
            background: var(--surface-color);
            overflow: hidden;
            border-radius: 16px;
            box-shadow: 0 20px 80px rgba(0,0,0,0.02);
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .main-image-container:hover {
            cursor: zoom-in;
        }

        .main-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.1s ease-out;
            pointer-events: none;
        }

        .wishlist-toggle {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 43px;
            height: 41.18px;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(4px);
            border: none;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: background 0.3s;
            z-index: 10;
        }

        .wishlist-toggle:hover {
            background: #ffffff;
        }

        /* --- Product Details Right Panel --- */
        .product-details {
            display: flex;
            flex-direction: column;
            padding-top: 10px;
            position: sticky;
            top: 140px;
        }

        .editorial-label {
            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .product-title {
            font-family: var(--font-serif);
            font-size: clamp(2.5rem, 5vw, 3.5rem);
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -0.02em;
            margin-bottom: 12px;
            color: var(--text-primary);
        }

        .product-price {
            font-size: 28px;
            font-weight: 500;
            color: var(--text-primary);
            letter-spacing: -0.02em;
        }

        .price-wrapper {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 32px;
        }

        .original-price {
            font-size: 16px;
            color: var(--text-muted);
            text-decoration: line-through;
            font-weight: 300;
        }

        .discount-badge {
            background: #EBF7EE;
            color: #1B7A3D;
            font-size: 8px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .rating-summary {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .rating-stars {
            display: flex;
            gap: 2px;
        }

        .rating-text {
            font-size: 12px;
            color: var(--text-secondary);
            font-weight: 400;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 2px;
            cursor: pointer;
        }

        .stock-info {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
            font-size: 12px;
            font-weight: 500;
        }

        .stock-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .stock-in { color: #1B7A3D; }
        .stock-in .stock-dot { background: #1B7A3D; }
        .stock-low { color: #B04040; }
        .stock-low .stock-dot { background: #B04040; animation: pulse 2s infinite; }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.4; }
            100% { opacity: 1; }
        }

        /* Minimalist Modern Offer Design */
        .modern-offers-wrapper {
            margin-bottom: 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .modern-offer-card {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
            max-width: 320px;
        }

        .modern-offer-card.best-applied {
            border-color: rgba(169, 29, 29, 0.15);
        }

        .offer-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .offer-left-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .offer-badge {
            background: #A91D1D;
            color: #fff;
            padding: 0.25rem 0.6rem;
            border-radius: 0.4rem;
            font-weight: 900;
            font-family: 'Outfit', sans-serif;
            font-size: 0.65rem;
            letter-spacing: 0.02em;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .offer-applied-text {
            font-size: 0.45rem;
            font-weight: 900;
            letter-spacing: 0.05em;
            color: #A91D1D;
            text-transform: uppercase;
        }

        .offer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .offer-name {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 0.7rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            color: #1a1a1a;
        }

        .offer-save {
            font-size: 0.6rem;
            font-weight: 700;
            color: #1a1a1a;
            opacity: 0.8;
        }

        .short-desc {
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 24px;
        }

        .long-desc {
            font-size: 15px;
            line-height: 1.7;
            color: var(--text-secondary);
            margin-bottom: 32px;
            font-weight: 300;
        }

        /* Option Selectors */
        .option-group {
            margin-bottom: 32px;
        }

        .option-label {
            font-size: 11px;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .swatches {
            display: flex;
            gap: 16px;
        }

        .swatch {
            width: 24px;
            height: 24px;
            cursor: pointer;
            position: relative;
            border-radius: 50%;
            border: 1px solid var(--border-color);
        }

        .swatch.active::after {
            content: '';
            position: absolute;
            top: -4px;
            left: -4px;
            right: -4px;
            bottom: -4px;
            border: 1px solid var(--accent-color);
            border-radius: 50%;
            padding: 4px;
        }

        .size-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .size-btn {
            height: 52px;
            border: 1px solid var(--border-color);
            background: none;
            font-size: 13px;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            color: var(--text-secondary);
        }

        .size-btn:hover {
            border-color: var(--accent-color);
        }

        .size-btn.active {
            background: var(--accent-color);
            color: #ffffff;
            border-color: var(--accent-color);
        }

        .size-guide-link {
            font-size: 10px;
            text-decoration: underline;
            color: var(--text-muted);
            text-transform: uppercase;
            cursor: pointer;
        }

        /* Quantity Stepper */
        .quantity-stepper {
            display: flex;
            align-items: center;
            border: 1px solid var(--border-color);
            width: 120px;
            height: 48px;
            margin-bottom: 32px;
            border-radius: 8px;
            overflow: hidden;
        }

        .qty-btn {
            flex: 1;
            height: 100%;
            border: none;
            background: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .qty-val {
            width: 48px;
            text-align: center;
            font-size: 14px;
        }

        /* Action Buttons */
        .action-btns {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 32px;
        }

        .btn-primary {
            height: 54px;
            background: var(--accent-color);
            color: #ffffff;
            border: none;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border-radius: 4px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-primary:hover {
            background: #222;
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .btn-secondary {
            height: 54px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            color: var(--accent-color);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .btn-secondary:hover {
            border-color: var(--accent-color);
            background: #fafafa;
        }

        /* Accordions */
        .accordions {
            margin-top: 40px;
            width: 100%;
        }

        .accordion-item {
            border-top: 1px solid var(--border-color);
            padding: 24px 0;
        }

        .accordion-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            margin-bottom: 16px;
        }

        .accordion-title {
            font-size: 12px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--text-primary);
        }

        .accordion-content {
            font-size: 14px;
            line-height: 1.8;
            color: var(--text-secondary);
            padding-bottom: 24px;
            max-width: 90%;
        }

        .accordion-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .accordion-list li {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bullet {
            width: 6px;
            height: 6px;
            background: #D4D4D8;
        }

        /* --- Related Products Section --- */
        .related-section {
            background: var(--surface-color);
            padding: 96px 48px;
            margin-top: 96px;
        }

        .related-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 64px;
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
        }

        .product-card {
            display: flex;
            flex-direction: column;
            cursor: pointer;
        }

        .card-img {
            aspect-ratio: 266/354;
            background: #ffffff;
            margin-bottom: 24px;
            overflow: hidden;
            border-radius: 8px;
        }

        .card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .product-card:hover .card-img img {
            transform: scale(1.05);
        }

        .card-category {
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .card-price {
            font-size: 14px;
            color: #71717A;
        }

        /* --- Customer Reviews Section --- */
        .reviews-section {
            max-width: 1300px;
            margin: 64px auto;
            padding: 64px;
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 24px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.03);
            display: grid;
            grid-template-columns: 341px 1fr;
            gap: 80px;
        }

        @media (max-width: 1024px) {
            .reviews-section {
                grid-template-columns: 1fr;
                gap: 48px;
                padding: 40px 24px;
                margin: 32px 16px;
                border-radius: 16px;
            }
            .review-list {
                padding-top: 0 !important;
            }
        }

        .reviews-summary h2 {
            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .reviews-summary h3 {
            font-family: var(--font-serif);
            font-size: 36px;
            margin-bottom: 16px;
        }

        .rating-hero {
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 32px;
        }

        .rating-val {
            font-family: var(--font-serif);
            font-size: 48px;
            font-weight: 300;
        }

        .stars-row {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 4px;
        }

        .stars-row svg {
            display: block;
        }

        .rating-count {
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .filter-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }

        .filter-label {
            width: 64px;
            font-size: 11px;
            letter-spacing: 1.1px;
            text-transform: uppercase;
        }

        .filter-bar-bg {
            flex: 1;
            height: 2px;
            background: #F4F4F5;
            position: relative;
        }

        .filter-bar-fill {
            position: absolute;
            height: 100%;
            background: var(--accent-color);
        }

        .filter-percent {
            font-size: 11px;
            color: var(--text-muted);
        }

        .review-list {
            display: flex;
            flex-direction: column;
            gap: 64px;
            padding-top: 84px;
        }

        .review-card {
            transition: all 0.3s ease;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
        }

        .review-stars {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 2px;
            color: #000;
        }

        .review-title {
            font-family: var(--font-serif);
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .review-author {
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .verified-badge {
            background: #FAFAFA;
            padding: 4px 8px;
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 9px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .review-text {
            font-size: 14px;
            line-height: 1.6;
            color: rgba(26, 28, 28, 0.7);
            max-width: 672px;
        }

        /* --- Footer --- */
        footer {
            padding: 48px 48px 96px;
            background: var(--bg-color);
            border-top: 1px solid rgba(228, 228, 231, 0.2);
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1.5fr;
            gap: 48px;
            margin-bottom: 96px;
        }

        .footer-brand h2 {
            font-family: var(--font-serif);
            font-size: 24px;
            font-weight: 900;
            margin-bottom: 22px;
        }

        .footer-brand p {
            font-size: 14px;
            color: var(--text-secondary);
            max-width: 384px;
            margin-bottom: 24px;
        }

        .footer-links h4 {
            font-size: 11px;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            margin-bottom: 24px;
        }

        .footer-nav {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .footer-nav a {
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 14px;
        }

        .newsletter-input {
            border: none;
            border-bottom: 1px solid var(--accent-color);
            padding: 8px 0;
            width: 100%;
            background: none;
            font-family: var(--font-main);
            font-size: 14px;
            margin-top: 16px;
            outline: none;
        }

        .footer-bottom {
            border-top: 1px solid #F4F4F5;
            padding-top: 32px;
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        /* --- Animations --- */
        .reveal {
            /* Removed initial hidden state for reliability */
        }

        /* --- Review Modal Styles --- */
        .review-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .review-modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }
        .review-modal-card {
            background: #ffffff;
            width: 520px;
            max-width: 90%;
            max-height: 90vh;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            padding: 32px;
            overflow-y: auto;
            transform: translateY(30px) scale(0.95);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }
        .review-modal-overlay.active .review-modal-card {
            transform: translateY(0) scale(1);
        }
        .review-modal-card::-webkit-scrollbar {
            display: none;
        }
        .review-modal-card {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        .modal-title {
            font-family: var(--font-serif);
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
        }
        .modal-close-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--text-muted);
            transition: color 0.2s ease, transform 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-close-btn:hover {
            color: var(--text-primary);
            transform: rotate(90deg);
        }
        .modal-rating-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }
        .modal-rating-label {
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            font-weight: 600;
        }
        .modal-stars {
            display: flex;
            gap: 6px;
        }
        .modal-star {
            cursor: pointer;
            transition: transform 0.2s ease, fill 0.2s ease;
        }
        .modal-star:hover {
            transform: scale(1.15);
        }
        .modal-input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }
        .modal-input-label {
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            font-weight: 600;
        }
        .modal-text-input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 10px;
            font-size: 14px;
            font-family: var(--font-main);
            outline: none;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            background: #fafafa;
        }
        .modal-text-input:focus {
            border-color: #111111;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.03);
        }
        .modal-textarea {
            resize: none;
            height: 110px;
        }
        .char-counter {
            display: flex;
            justify-content: flex-end;
            font-size: 11px;
            color: #9ca3af;
            margin-top: 4px;
        }
        .upload-label {
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            font-weight: 600;
            margin-bottom: 4px;
        }
        .upload-zone {
            border: 1.5px dashed rgba(0,0,0,0.15);
            border-radius: 12px;
            padding: 32px 16px;
            text-align: center;
            cursor: pointer;
            background: #ffffff;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 8px;
        }
        .upload-zone:hover {
            border-color: #111111;
            background: #fafafa;
        }
        .camera-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,0,0,0.03);
            transition: transform 0.2s ease;
        }
        .upload-zone:hover .camera-icon-wrapper {
            transform: scale(1.05);
        }
        .upload-main-text {
            font-size: 14px;
            font-weight: 600;
            color: #111111;
            margin: 0;
        }
        .upload-sub-text {
            font-size: 12px;
            color: #9ca3af;
            margin: 0;
        }
        .media-previews-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 12px;
        }
        .media-preview-item {
            position: relative;
            width: 72px;
            height: 72px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.1);
            animation: fadeIn 0.3s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
        .media-preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .media-preview-remove {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: rgba(0,0,0,0.6);
            color: #ffffff;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            transition: background 0.2s ease;
        }
        .media-preview-remove:hover {
            background: rgba(220,38,38,0.9);
        }
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            margin-top: 32px;
            border-top: 1px solid rgba(0,0,0,0.05);
            padding-top: 20px;
        }
        .btn-submit-review {
            height: 48px;
            padding: 0 28px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            border: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-submit-review:disabled {
            background: #E5E7EB;
            color: #9CA3AF;
            cursor: not-allowed;
        }
        .btn-submit-review:not(:disabled) {
            background: #000000;
            color: #ffffff;
            cursor: pointer;
        }
        .btn-submit-review:not(:disabled):hover {
            background: #222222;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .btn-submit-review:not(:disabled):active {
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main>


      <%- include('../partials/breadcrumbs', { 
          breadcrumbs: [
              { name: category?.name || "Category", url: "/men-product-list" },
              { name: subCategory?.name || "Subcategory", url: "/men-product-list?sub=" + subCategory?._id },
              { name: product.name }
          ] 
      }) %>



        <section class="product-images">
            <div class="thumbnail-strip">
                <% if (variant && variant.images && variant.images.length > 0) { %>
                    <% variant.images.forEach((img, idx) => { %>
                        <div class="thumbnail <%= idx === 0 ? 'active-thumb' : '' %>" onclick="switchImage('<%= img %>', this)">
                            <img src="<%= img %>" alt="View <%= idx + 1 %>">
                        </div>
                    <% }) %>
                <% } %>
            </div>
            <div class="main-image-column">
                <div class="main-image-container">
                    <img id="mainImage" src="<%= variant?.images?.[0] %>" alt="Product Image" class="main-image" style="opacity: 1 !important;">
                    <button class="wishlist-toggle <%= (locals.wishlist || []).includes(product._id.toString()) ? 'favorited text-red-500' : '' %>">
                        <i data-lucide="heart" size="19" class="<%= (locals.wishlist || []).includes(product._id.toString()) ? 'fill-red-500' : '' %>"></i>
                    </button>
                </div>
                <script>
                    const bestOffer = <%- JSON.stringify(bestOffer) %>;
                </script>
                
                <!-- Accordions strictly below the image -->
                <div class="accordions reveal" style="transition-delay: 0.6s; margin-top: 40px; border-top: 1px solid var(--border-color);">
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span class="accordion-title">Material</span>
                            <i data-lucide="plus" size="14"></i>
                        </div>
                        <div class="accordion-content">
                            <ul class="accordion-list">
                                <li><div class="bullet"></div> <%= product.material%></li>
                              
                            </ul>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span class="accordion-title">Care guide</span>
                            <i data-lucide="plus" size="14"></i>
                        </div>
                        <div class="accordion-content">
                         <%=product.careGuide%>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="product-details">
            <div class="reveal" style="transition-delay: 0.2s;">
                <p class="editorial-label"> <%= product.category.name || "NEW ARRIVAL" %></p>
                <h1 class="product-title"><%= product.name %></h1>
                
                <div class="rating-summary" id="headerRatingContainer" style="display: none; align-items: center; gap: 8px;">
                    <div class="rating-stars" id="headerStarsRow" style="display: flex; gap: 4px;"></div>
                    <span class="rating-text" id="headerRatingText"></span>
                </div>

                <div class="price-wrapper">
                    <% if (bestOffer && (!bestOffer.minOrderValue || variant.price >= bestOffer.minOrderValue)) { 
                        let discountAmount = 0;
                        if (bestOffer.discountMode === 'percentage') {
                            discountAmount = (variant.price * bestOffer.discountValue) / 100;
                            if (bestOffer.maxDiscountCap) discountAmount = Math.min(discountAmount, bestOffer.maxDiscountCap);
                        } else {
                            discountAmount = bestOffer.discountValue;
                        }
                        const finalPrice = Math.max(0, variant.price - discountAmount);
                    %>
                        <p class="product-price" id="productPrice">₹<%= Math.round(finalPrice) %></p>
                        <p class="original-price" id="originalPrice">₹<%= variant.price %></p>
                        <div class="discount-badge"><%= bestOffer.discountMode === 'percentage' ? bestOffer.discountValue + '% OFF' : '₹' + bestOffer.discountValue + ' OFF' %></div>
                    <% } else { %>
                        <p class="product-price" id="productPrice">₹<%= variant?.price %></p>
                        <p class="original-price hidden" id="originalPrice"></p>
                        <div class="discount-badge hidden"></div>
                    <% } %>
                </div>
                
                <div class="modern-offers-wrapper reveal" style="transition-delay: 0.25s;">
                    <% if (locals.bestOffer) { %>
                        <% const offer = bestOffer; %>
                        <div class="modern-offer-card best-applied">
                            <div class="offer-top">
                                <div class="offer-left-group">
                                    <div class="offer-badge">
                                        <i data-lucide="zap" size="10" fill="currentColor"></i>
                                        <%= offer.discountMode === 'percentage' ? offer.discountValue + '% OFF' : '₹' + offer.discountValue + ' OFF' %>
                                    </div>
                                    <span class="offer-applied-text">BEST OFFER APPLIED</span>
                                </div>
                            </div>
                            <div class="offer-bottom">
                                <div class="offer-name"><%= offer.offerLabel %></div>
                                <div class="offer-save">
                                    <% 
                                       let saveAmount = 0;
                                       if (offer.discountMode === 'percentage') {
                                           saveAmount = (variant.price * offer.discountValue) / 100;
                                           if (offer.maxDiscountCap) saveAmount = Math.min(saveAmount, offer.maxDiscountCap);
                                       } else {
                                           saveAmount = offer.discountValue;
                                       }
                                    %>
                                    You save ₹<%= Math.round(saveAmount) %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div id="stockInfoContainer" class="stock-info <%= (variant?.stock || 0) < 5 ? 'stock-low' : 'stock-in' %>">
                    <div class="stock-dot"></div>
                    <span id="stockStatus"><%= (variant?.stock || 0) < 5 ? 'Limited Stock: Only ' + variant.stock + ' left' : 'In Stock & Ready to Ship' %></span>
                </div>
            </div>

            <div class="reveal" style="transition-delay: 0.3s;">
                <!-- <p class="short-desc">"Lightweight comfort meets effortless style"</p> -->
                <p class="long-desc">
                    <%= product.description %>
                </p>
            </div>

            <% 
              // Group variants by color for clean rendering
              const colorGroups = {};
              variants.forEach(v => {
                if (!colorGroups[v.color]) {
                  colorGroups[v.color] = [];
                }
                colorGroups[v.color].push(v);
              });
              const uniqueColors = Object.keys(colorGroups);
            %>

            <div class="option-group reveal" style="transition-delay: 0.4s;">
                <div class="option-label" id="colorLabel">Select Color</div>
               <div class="swatches">
                   <% uniqueColors.forEach(color => { 
                       const group = colorGroups[color];
                       // Use the first variant of the group as the representative for images/prices
                       const rep = group[0];
                   %>
                   <div 
                      class="swatch"
                      style="background:<%= color %>"
                      data-color="<%= color %>"
                      data-variants='<%= JSON.stringify(group) %>'
                   >
                   </div>
                   <% }) %>
             </div>
            </div>

            <div class="option-group reveal" style="transition-delay: 0.5s;">
                <div class="option-label">
                    <span>Select Size</span>
                    <span class="size-guide-link">Size Guide</span>
                </div>
                <div class="size-grid" id="sizeGrid">
                    <!-- Sizes will be populated dynamically based on color selection -->
                    <p class="text-[10px] text-stone-400 uppercase tracking-widest py-4">Please select a color first</p>
                </div>
            </div>

            <div class="reveal" style="transition-delay: 0.6s;">
                <div class="option-label">Quantity</div>
                <div class="quantity-stepper" data-stock="0" data-variant="">
                    <button class="qty-btn" id="decrease">-</button>
                 <div class="qty-val" id="qtyValue">1</div>
                 <button class="qty-btn" id="increase">+</button>
                </div>



                <div class="action-btns">
