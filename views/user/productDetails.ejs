                    <div class="camera-icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
                            <circle cx="12" cy="13" r="3"></circle>
                        </svg>
                    </div>
                    <p class="upload-main-text"><span style="text-decoration: underline;">Click to upload</span> or drag and drop</p>
                    <p class="upload-sub-text">SVG, PNG, JPG (max. 3 images)</p>
                    <input type="file" id="mediaInput" style="display: none;" accept="image/*" multiple>
                </div>
                <div class="media-previews-container" id="mediaPreviews"></div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="submit" id="submitReviewBtn" class="btn-submit-review" disabled>Submit Review</button>
            </div>
        </form>
    </div>
</div>

