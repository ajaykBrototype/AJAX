<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AJAX — Timeless Luxury</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
tailwind.config = {
  theme: { 
      extend: { 
          fontFamily: { 
              serif: ['Playfair Display', 'serif'], 
              sans: ['Inter', 'sans-serif'] 
          },
          colors: {
              luxury: {
                  bg: '#F5F1EB',
                  dark: '#1A1A1A',
                  accent: '#B89D7A',
                  secondary: '#EAE4DC',
              }
          }
      } 
  }
}
</script>
<%- include("../partials/navbar-hero-styles.ejs") %>
<style>
/* CORE STYLES */
body {
    background-color: #F5F1EB;
    color: #1A1A1A;
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

/* HERO SECTION */
.hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.hero-bg {
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1920&q=90&auto=format&fit=crop') center 30%/cover;
    animation: slowZoom 20s ease-out both;
}
@keyframes slowZoom {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
}
.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,26,26,0.85) 0%, rgba(26,26,26,0.3) 50%, rgba(26,26,26,0.6) 100%);
}
.hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: white;
    padding: 0 1.5rem;
}
.hero-eye {
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #B89D7A;
    margin-bottom: 2rem;
    display: block;
}
.hero-title {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 1.05;
    margin-bottom: 3rem;
}
.btn-outline {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: white;
    border: 1px solid rgba(255,255,255,0.6);
    padding: 1.1rem 3rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(5px);
}
.btn-outline:hover {
    background: white;
    color: #1A1A1A;
    border-color: white;
    transform: translateY(-2px);
}
.btn-filled {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    background: white;
    color: #1A1A1A;
    border: 1px solid white;
    padding: 1.1rem 3rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.btn-filled:hover {
    background: transparent;
    color: white;
}
.scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 10;
}
.scroll-text {
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
}
.scroll-line {
    width: 1px;
    height: 45px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.6), transparent);
    animation: scrollLine 2s ease-in-out infinite;
}
@keyframes scrollLine {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    50.1% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
}

/* SECTION UTILITIES */
.section-padding { padding: 7rem 4rem; max-width: 1536px; margin: 0 auto; }
@media(max-width: 768px) { .section-padding { padding: 4rem 1.5rem; } }

.section-header { text-align: center; margin-bottom: 4rem; }
.section-eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #B89D7A;
    margin-bottom: 1rem;
    display: block;
}
.section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: #1A1A1A;
    font-weight: 400;
}

/* BENTO CATEGORY GRID */
.editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}
@media(min-width: 768px) {
    .editorial-grid {
        grid-template-columns: 7fr 5fr;
    }
}
.ed-card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 15px 35px -15px rgba(0,0,0,0.1);
    transform: translateZ(0); /* Hardware acceleration */
}
.ed-card img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.ed-card:hover img { transform: scale(1.08); }
.ed-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15,15,15,0.9) 0%, rgba(15,15,15,0.2) 50%, transparent 100%);
    opacity: 0.5;
    transition: opacity 0.6s ease;
}
.ed-card:hover .ed-overlay { opacity: 0.85; }
.ed-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 2.5rem;
    color: white;
    transform: translateY(15px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.ed-card:hover .ed-content { transform: translateY(0); }
.ed-label {
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    display: block;
    opacity: 0.8;
}
.ed-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.1;
}
.ed-card.small .ed-title { font-size: 1.75rem; margin-bottom: 0.5rem; }
.ed-link {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.4);
    padding-bottom: 0.25rem;
    transition: border-color 0.3s;
}
.ed-card:hover .ed-link { border-color: white; }

/* PRODUCT SLIDER & CARDS */
.product-slider {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2rem 0 4rem; 
    margin: 0 -1.5rem;
    padding-inline: 1.5rem;
    scrollbar-width: none;
    cursor: grab;
}
.product-slider:active { cursor: grabbing; }
.product-slider::-webkit-scrollbar { display: none; }
.product-card {
    min-width: 320px;
    scroll-snap-align: center;
    position: relative;
}
@media(max-width: 640px) { .product-card { min-width: 280px; } }
.prod-img-wrapper {
    position: relative;
    background: #EAE4DC;
    border-radius: 1.25rem;
    overflow: hidden;
    aspect-ratio: 4/5;
    margin-bottom: 1.5rem;
    box-shadow: 0 15px 35px -15px rgba(0,0,0,0.05);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.product-card:hover .prod-img-wrapper {
    box-shadow: 0 25px 50px -20px rgba(0,0,0,0.15);
    transform: translateY(-8px);
}
.prod-img-primary, .prod-img-secondary {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: opacity 0.8s ease, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.prod-img-secondary { opacity: 0; transform: scale(1.05); }
.product-card:hover .prod-img-primary { opacity: 0; }
.product-card:hover .prod-img-secondary { opacity: 1; transform: scale(1); }

.quick-add {
    position: absolute;
    bottom: 1.25rem; left: 1.25rem; right: 1.25rem;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    color: #1A1A1A;
    text-align: center;
    padding: 1rem;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border-radius: 0.75rem;
    transform: translateY(150%);
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    font-weight: 500;
}
.product-card:hover .quick-add { transform: translateY(0); opacity: 1; }
.wishlist-btn {
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    width: 44px; height: 44px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(8px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1A1A1A;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.product-card:hover .wishlist-btn { opacity: 1; transform: scale(1); }
.wishlist-btn:hover { background: #1A1A1A; color: white; }

.new-badge {
    position: absolute;
    top: 1.25rem; left: 1.25rem;
    background: #1A1A1A;
    color: white;
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    z-index: 10;
}

.prod-info { text-align: center; }
.prod-name { font-size: 0.9rem; color: #1A1A1A; margin-bottom: 0.4rem; font-weight: 500; letter-spacing: 0.02em; }
.prod-price { font-size: 0.85rem; color: #666; font-family: 'Playfair Display', serif; font-style: italic; }

/* BRAND STORY */
.story-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #EAE4DC;
    border-radius: 2rem;
    overflow: hidden;
    margin: 4rem auto;
    max-width: 1440px;
}
@media(max-width: 768px) { .story-section { grid-template-columns: 1fr; } }
.story-img { height: 100%; min-height: 600px; object-fit: cover; }
.story-content {
    padding: 6rem 5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
}
@media(max-width: 1024px) { .story-content { padding: 4rem 3rem; } }
.story-title { font-family: 'Playfair Display', serif; font-size: 3rem; margin-bottom: 1.5rem; line-height: 1.1; }
.story-text { font-size: 0.9rem; line-height: 1.8; color: #4A4A4A; margin-bottom: 3rem; max-width: 400px; }

/* FEATURES */
.features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
}
@media(max-width: 900px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
@media(max-width: 480px) { .features-grid { grid-template-columns: 1fr; } }
.feature-card {
    text-align: center;
    background: #EAE4DC;
    padding: 3rem 2rem;
    border-radius: 1rem;
    transition: transform 0.4s ease;
}
.feature-card:hover { transform: translateY(-10px); }
.feat-icon { margin: 0 auto 1.5rem; color: #B89D7A; }
.feat-title { font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; margin-bottom: 0.75rem; }
.feat-desc { font-size: 0.8rem; color: #666; line-height: 1.6; }

/* NEWSLETTER */
.newsletter-section {
    background: #1A1A1A;
    color: white;
    text-align: center;
    padding: 8rem 2rem;
    margin: 4rem 2rem 0;
    border-radius: 2rem 2rem 0 0;
}
@media(max-width: 640px) { .newsletter-section { margin: 2rem 0 0; border-radius: 1.5rem 1.5rem 0 0; padding: 5rem 1.5rem; } }
.nl-form {
    display: flex;
    max-width: 500px;
    margin: 3rem auto 0;
    border-bottom: 1px solid rgba(255,255,255,0.3);
}
.nl-input {
    flex: 1;
    background: transparent;
    border: none;
    color: white;
    padding: 1rem 0;
    font-size: 0.85rem;
    outline: none;
}
.nl-input::placeholder { color: rgba(255,255,255,0.4); }
.nl-submit {
    background: transparent;
    border: none;
    color: white;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.3s;
}
.nl-submit:hover { color: #B89D7A; }

/* ANIMATIONS */
.gsap-up { opacity: 0; transform: translateY(40px); }
</style>
<%- include("../partials/footer-styles.ejs") %>
</head>
<body>

<%- include("../partials/navbar-hero.ejs") %>

<!-- 1. HERO SECTION -->
<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    
    <div class="hero-content">
        <span class="hero-eye gsap-hero">Autumn Winter 2026</span>
        <h1 class="hero-title gsap-hero">
            Timeless <i class="text-[#B89D7A]">Luxury</i>
        </h1>
        <div class="flex flex-col sm:flex-row gap-4 justify-center gsap-hero">
            <a href="/menProductList" class="btn-filled">Shop Men</a>
            <a href="/womenProductList" class="btn-outline">Shop Women</a>
        </div>
    </div>
    
    <div class="scroll-indicator gsap-hero">
        <span class="scroll-text">Discover</span>
        <div class="scroll-line"></div>
    </div>
</section>

<!-- 3. FEATURED COLLECTIONS (EDITORIAL EDIT) -->
<section class="section-padding">
    <div class="section-header gsap-up">
        <span class="section-eyebrow">Curations</span>
        <h2 class="section-title">The Editorial Edit</h2>
    </div>
    
    <div class="editorial-grid">
        <!-- Main Large Card -->
        <a href="/menProductList" class="ed-card md:h-[640px] h-[500px] gsap-up">
            <img src="/images/menproduct.png" alt="Menswear Collection" loading="lazy">
            <div class="ed-overlay"></div>
            <div class="ed-content">
                <span class="ed-label">Autumn Collection</span>
                <h3 class="ed-title">Menswear <br>Tailoring</h3>
                <span class="ed-link">Discover Collection <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </div>
        </a>
        
        <!-- Stacked Right Column -->
        <div class="flex flex-col gap-6">
            <!-- Top Right: Womenswear -->
            <a href="/womenProductList" class="ed-card h-[308px] small gsap-up" style="transition-delay: 0.1s">
                <img src="/images/womenproduct.jpg" alt="Womenswear" loading="lazy">
                <div class="ed-overlay"></div>
                <div class="ed-content">
                    <span class="ed-label">New Season</span>
                    <h3 class="ed-title">Womenswear</h3>
                    <span class="ed-link" style="border-bottom-width: 0;">Explore</span>
                </div>
            </a>
            
            <!-- Bottom Right: Kids (Coming Soon) -->
            <div class="ed-card h-[308px] small gsap-up relative group cursor-not-allowed" style="transition-delay: 0.2s">
                <img src="https://images.unsplash.com/photo-1514090458221-65bb69cf63e6?w=800&q=90&auto=format&fit=crop" alt="Kids Collection" loading="lazy" class="blur-[4px] scale-105 group-hover:scale-[1.08] transition-transform duration-1000">
                <div class="ed-overlay" style="background: rgba(15,15,15,0.4);"></div>
                
                <!-- Center "Coming Soon" Badge -->
                <div class="absolute inset-0 flex flex-col items-center justify-center z-20">
                    <span class="px-6 py-3 bg-white/20 backdrop-blur-md border border-white/30 rounded-full text-white text-[0.7rem] font-bold tracking-[0.2em] uppercase shadow-2xl">Coming Soon</span>
                </div>
                
                <div class="ed-content z-10 opacity-50">
                    <span class="ed-label">Little Icons</span>
                    <h3 class="ed-title">Kidswear</h3>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. NEW ARRIVALS SLIDER -->
<section class="section-padding py-0">
    <div class="flex justify-between items-end mb-10 gsap-up">
        <div>
            <span class="section-eyebrow">Just Landed</span>
            <h2 class="section-title">New Arrivals</h2>
        </div>
        <a href="/menProductList" class="hidden md:inline-block text-[0.65rem] tracking-[0.2em] uppercase border-b border-[#1A1A1A] pb-1 hover:text-[#B89D7A] hover:border-[#B89D7A] transition-colors">View All Collection</a>
    </div>
    
    <div class="product-slider gsap-up">
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
            <% products.forEach((product, index) => { %>
                <% const variant = product.variants && product.variants[0]; %>
                <!-- Card <%= index + 1 %> -->
                <div class="product-card">
                    <a href="/product/<%= product._id %>" class="block">
                        <div class="prod-img-wrapper">
                            <% if (index === 0) { %>
                                <span class="new-badge">New Season</span>
                            <% } else if (index === 2) { %>
                                <span class="new-badge" style="background: white; color: #1A1A1A;">Bestseller</span>
                            <% } %>
                            <button class="wishlist-btn" onclick="event.preventDefault(); if(typeof toggleWishlist === 'function') toggleWishlist('<%= product._id %>', this, '<%= variant?._id %>')">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>
                            <% if (variant && variant.images && variant.images.length > 0) { %>
                                <img src="<%= variant.images[0] %>" class="prod-img-primary" alt="<%= product.name %>">
                                <% if (variant.images[1]) { %>
                                    <img src="<%= variant.images[1] %>" class="prod-img-secondary" alt="<%= product.name %> alt">
                                <% } %>
                            <% } else { %>
                                <div class="w-full h-full bg-gray-200"></div>
                            <% } %>
                            <button class="quick-add" onclick="event.preventDefault(); window.location.href='/product/<%= product._id %>'">Quick Add to Bag</button>
                        </div>
                        <div class="prod-info">
                            <h4 class="prod-name"><%= product.name %></h4>
                            <p class="prod-price">
                                <% if(product.offer) { %>
                                    <span style="color: #1A1A1A;">₹<%= Math.round(product.finalPrice) %></span>
                                    <span style="text-decoration: line-through; opacity: 0.4; margin-left: 8px;">₹<%= variant?.price || 0 %></span>
                                <% } else { %>
                                    ₹<%= variant?.price || 0 %>
                                <% } %>
                            </p>
                        </div>
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="w-full text-center py-10">
                <p class="text-[0.65rem] tracking-[0.2em] uppercase text-gray-500">New arrivals dropping soon.</p>
            </div>
        <% } %>
    </div>
</section>

<!-- 6. BRAND STORY -->
<section class="section-padding">
    <div class="story-section gsap-up">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=1000&q=90" alt="Brand Story" class="story-img">
        <div class="story-content">
            <span class="section-eyebrow">The Philosophy</span>
            <h2 class="story-title">Crafted for modern elegance.</h2>
            <p class="story-text">We believe in clothes that endure. Free from the noise of transient trends, our garments are meticulously constructed using the world's finest materials to create a wardrobe of uncompromising quality and timeless silhouettes.</p>
            <div>
                <a href="#" class="inline-block border-b border-[#1A1A1A] text-[0.65rem] tracking-[0.2em] uppercase pb-1 hover:text-[#B89D7A] hover:border-[#B89D7A] transition-colors">Discover Our Story</a>
            </div>
        </div>
    </div>
</section>

<!-- 7. LUXURY FEATURES -->
<section class="section-padding py-0 mb-16">
    <div class="features-grid">
        <div class="feature-card gsap-up">
            <svg class="feat-icon w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
            <h4 class="feat-title">Complimentary Shipping</h4>
            <p class="feat-desc">On all domestic orders over ₹5,000.</p>
        </div>
        <div class="feature-card gsap-up" style="transition-delay: 0.1s">
            <svg class="feat-icon w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <h4 class="feat-title">Secure Payments</h4>
            <p class="feat-desc">Encrypted processing for your peace of mind.</p>
        </div>
        <div class="feature-card gsap-up" style="transition-delay: 0.2s">
