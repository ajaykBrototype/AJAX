<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Sales Report — AJAX Admin</title>

<!-- FONTS -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          serif: ['Playfair Display', 'serif'],
          sans: ['Outfit', 'sans-serif']
        },
        colors: {
          brand: {
            dark: '#1C1C1C',
            muted: '#888888',
            border: 'rgba(0,0,0,0.06)',
            bg: '#FAFAF8'
          }
        }
      }
    }
  }
</script>

<style>
  body { 
    background: #FAFAF8; 
    color: #1C1C1C; 
    font-family: 'Outfit', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .editorial-title { font-family: 'Playfair Display', serif; }
  
  .glass-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.04);
    box-shadow: 0 4px 30px rgba(0,0,0,0.02);
    border-radius: 28px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8F8F6;
    color: #1C1C1C;
    border: 1px solid rgba(0,0,0,0.05);
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #E5E5E5; border-radius: 10px; }

  @keyframes slideInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-up { animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }

  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
  .delay-3 { animation-delay: 0.3s; }
  .delay-4 { animation-delay: 0.4s; }

  .modern-table th {
    padding: 16px 24px;
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #888888;
    border-bottom: 1px solid rgba(0,0,0,0.04);
  }
  .modern-table td {
    padding: 20px 24px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1C1C1C;
    border-bottom: 1px solid rgba(0,0,0,0.02);
  }
  .modern-table tr:last-child td { border-bottom: none; }
</style>
</head>
<body class="flex min-h-screen overflow-x-hidden">

  <!-- SIDEBAR (PARTIAL) -->
  <%- include('partials/sidebar', { currentPath: '/admin/sales-report' }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-1 flex flex-col min-w-0">
    
    <!-- Top Nav / Header -->
    <header class="bg-white/80 backdrop-blur-md border-b border-brand-border px-10 py-8 sticky top-0 z-50">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="editorial-title text-4xl italic tracking-tight mb-2">Sales <span class="not-italic font-black text-brand-dark">Report</span></h1>
          <p class="text-[0.7rem] font-bold text-brand-muted uppercase tracking-[0.2em]">
            Performance overview <span class="mx-2 text-stone-300">•</span> May 01, 2026 — May 16, 2026
          </p>
        </div>
        
        <div class="flex items-center gap-4">
          <!-- Time Period Selector (Custom Modern Dropdown) -->
          <div class="relative group" id="periodDropdown">
            <button id="dropdownBtn" class="flex items-center gap-4 pl-6 pr-5 py-3 bg-white border border-brand-border text-brand-dark rounded-full text-[0.7rem] font-black uppercase tracking-widest hover:border-brand-dark transition-all active:scale-95">
              <span id="selectedPeriodText">Month</span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="ml-2 transition-transform duration-300" id="dropdownArrow"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div id="dropdownMenu" class="absolute right-0 mt-3 w-56 bg-white border border-brand-border rounded-[28px] shadow-[0_20px_50px_rgba(0,0,0,0.1)] py-3 opacity-0 invisible translate-y-4 transition-all duration-300 z-[100] overflow-hidden backdrop-blur-xl bg-white/95">
              <div class="px-5 py-2 text-[0.55rem] font-black text-brand-muted uppercase tracking-[0.2em] border-b border-brand-border/50 mb-2">Analysis Period</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" data-value="day">Day</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" data-value="week">Week</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" data-value="month">Month</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" data-value="year">Year</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-muted hover:text-brand-dark hover:bg-brand-bg cursor-pointer transition-all border-t border-brand-border/50 mt-2" data-value="custom">Custom Range</div>
            </div>
          </div>

          <!-- Export Button -->
          <div class="relative group">
            <button class="flex items-center gap-3 pl-6 pr-5 py-3 bg-brand-dark text-white rounded-full text-[0.7rem] font-black uppercase tracking-widest hover:bg-black transition-all shadow-xl shadow-black/10 active:scale-95">
              Export
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="p-10 space-y-10">
      
      <!-- Top Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Revenue -->
        <div class="glass-card p-8 animate-slide-up">
          <div class="flex justify-between items-start mb-8">
            <div class="stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="flex flex-col items-end">
              <span class="text-[0.6rem] font-black text-rose-500 bg-rose-50 px-2 py-1 rounded-lg uppercase tracking-tighter mb-1">-64.37%</span>
              <span class="text-[0.5rem] font-bold text-brand-muted uppercase tracking-widest">vs prev. period</span>
            </div>
          </div>
          <p class="text-[0.65rem] font-bold text-brand-muted uppercase tracking-[0.2em] mb-2">Total Revenue</p>
          <h3 class="text-4xl font-black tracking-tighter">₹<%= reportData.totalRevenue.toLocaleString() %></h3>
        </div>

        <!-- Orders -->
        <div class="glass-card p-8 animate-slide-up delay-1">
          <div class="flex justify-between items-start mb-8">
            <div class="stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </div>
          </div>
          <p class="text-[0.65rem] font-bold text-brand-muted uppercase tracking-[0.2em] mb-2">Total Orders</p>
          <div class="flex items-baseline gap-3">
            <h3 class="text-4xl font-black tracking-tighter"><%= reportData.deliveredOrders %></h3>
            <span class="text-[0.6rem] font-bold text-brand-muted uppercase tracking-widest">Delivered orders</span>
          </div>
        </div>

        <!-- Products Sold -->
        <div class="glass-card p-8 animate-slide-up delay-2">
          <div class="flex justify-between items-start mb-8">
            <div class="stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
          </div>
          <p class="text-[0.65rem] font-bold text-brand-muted uppercase tracking-[0.2em] mb-2">Products Sold</p>
          <div class="flex items-baseline gap-3">
            <h3 class="text-4xl font-black tracking-tighter"><%= reportData.productsSold %></h3>
            <span class="text-[0.6rem] font-bold text-brand-muted uppercase tracking-widest">Total units dispatched</span>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        <!-- Revenue Overview Chart -->
        <div class="lg:col-span-2 glass-card p-8 animate-slide-up delay-3 flex flex-col">
          <div class="flex items-center justify-between mb-10">
            <div>
              <h4 class="text-xl font-black tracking-tight mb-1">Revenue Overview</h4>
              <p class="text-[0.6rem] text-brand-muted font-bold uppercase tracking-widest">Daily sales peak • May 01 — May 16</p>
            </div>
            <div class="text-right">
              <h3 class="text-2xl font-black tracking-tighter">₹4,083.40</h3>
              <span class="text-[0.6rem] font-black text-rose-500 bg-rose-50 px-2 py-0.5 rounded-md uppercase">-64.37%</span>
            </div>
          </div>
          <div class="flex-1 min-h-[350px]">
            <canvas id="revenueChart"></canvas>
          </div>
        </div>

        <!-- Growth Comparison -->
        <div class="lg:col-span-1 glass-card p-8 animate-slide-up delay-3 flex flex-col bg-brand-dark text-white border-none shadow-2xl">
          <h4 class="text-xl font-black tracking-tight mb-1">Growth Comparison</h4>
          <p class="text-[0.6rem] text-stone-400 font-bold uppercase tracking-widest mb-10">Current vs Previous Period</p>
          
          <div class="flex-1 flex flex-col justify-center gap-12">
            <div class="flex-1 min-h-[250px]">
               <canvas id="growthChart"></canvas>
            </div>
            <div class="text-center pt-6 border-t border-white/10">
              <p class="text-[0.55rem] font-black uppercase tracking-[0.3em] text-stone-500 mb-2">Analysis Result</p>
              <p class="text-sm font-bold text-rose-400 italic">"Moderate decline in realized revenue compared to last cycle."</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Tables -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pb-10">
        <!-- Coupon Usage Details -->
        <div class="glass-card overflow-hidden animate-slide-up delay-4">
          <div class="p-8 border-b border-brand-border">
            <h4 class="text-xl font-black tracking-tight">Coupon Usage Details</h4>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full modern-table">
              <thead>
                <tr class="bg-brand-bg/50">
                  <th>Coupon Code</th>
                  <th>Type</th>
                  <th>Discount</th>
                  <th class="text-center">Usage</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <span class="bg-indigo-50 text-indigo-600 px-3 py-1 rounded-full text-[0.6rem] font-black uppercase tracking-widest">SUMMER30</span>
                  </td>
                  <td>Flat</td>
                  <td>₹400.00</td>
                  <td class="text-center">3 / 100</td>
                  <td>
                    <span class="text-[0.6rem] font-black text-emerald-500 uppercase tracking-widest">Active</span>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span class="bg-rose-50 text-rose-600 px-3 py-1 rounded-full text-[0.6rem] font-black uppercase tracking-widest">FEST33</span>
                  </td>
                  <td>Percentage</td>
                  <td>15%</td>
                  <td class="text-center">1 / 50</td>
                  <td>
                    <span class="text-[0.6rem] font-black text-emerald-500 uppercase tracking-widest">Active</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Order Discount Breakdown -->
        <div class="glass-card overflow-hidden animate-slide-up delay-4">
          <div class="p-8 border-b border-brand-border flex justify-between items-center">
            <h4 class="text-xl font-black tracking-tight">Order Discount Breakdown</h4>
            <div class="bg-orange-50 text-orange-600 px-4 py-1.5 rounded-full text-[0.6rem] font-black uppercase tracking-widest">
              Total Saved: ₹490.00
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full modern-table">
              <thead>
                <tr class="bg-brand-bg/50">
                  <th>Order #</th>
                  <th>Date</th>
                  <th>Subtotal</th>
                  <th>Discount</th>
                  <th class="text-right">Final</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="font-bold text-[0.7rem]">#ORD-7UH9MHQ</td>
                  <td class="text-brand-muted">May 07, 2026</td>
                  <td>₹1,598.40</td>
                  <td class="text-rose-500">- ₹400.00</td>
                  <td class="text-right font-black">₹1,198.40</td>
                </tr>
                <tr>
                  <td class="font-bold text-[0.7rem]">#ORD-GYLU91O</td>
                  <td class="text-brand-muted">May 05, 2026</td>
                  <td>₹890.00</td>
                  <td class="text-stone-300">—</td>
                  <td class="text-right font-black">₹890.00</td>
                </tr>
                <tr>
                  <td class="font-bold text-[0.7rem]">#ORD-36UAM2A</td>
                  <td class="text-brand-muted">May 04, 2026</td>
                  <td>₹399.00</td>
                  <td class="text-stone-300">—</td>
                  <td class="text-right font-black">₹399.00</td>
                </tr>
              </tbody>
              <tfoot>
                <tr class="bg-brand-bg/30">
                  <td colspan="3" class="text-[0.6rem] font-black uppercase tracking-widest text-brand-muted">Totals (3)</td>
                  <td class="text-[0.7rem] font-black text-rose-500">- ₹400.00</td>
                  <td class="text-right text-[0.9rem] font-black">₹2,487.40</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    // Custom Dropdown Logic
    const dropdownBtn = document.getElementById('dropdownBtn');
    const dropdownMenu = document.getElementById('dropdownMenu');
    const dropdownArrow = document.getElementById('dropdownArrow');
    const selectedText = document.getElementById('selectedPeriodText');
    const dropdownItems = document.querySelectorAll('.dropdown-item');

    const toggleDropdown = () => {
      const isOpen = !dropdownMenu.classList.contains('invisible');
      if (isOpen) {
        dropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
        dropdownArrow.classList.remove('rotate-180');
      } else {
        dropdownMenu.classList.remove('opacity-0', 'invisible', 'translate-y-4');
        dropdownArrow.classList.add('rotate-180');
      }
    };

    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    document.addEventListener('click', () => {
      dropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
      dropdownArrow.classList.remove('rotate-180');
    });

    dropdownItems.forEach(item => {
      item.addEventListener('click', () => {
        selectedText.innerText = item.innerText;
      });
    });

    // Revenue Chart (Line)
    const revCtx = document.getElementById('revenueChart').getContext('2d');
    new Chart(revCtx, {
      type: 'line',
      data: {
        labels: ['1', '3', '5', '7', '9', '11', '13', '15'],
        datasets: [{
          label: 'Daily Sales',
          data: [0, 1000, 200, 1000, 100, 1600, 100, 100],
          borderColor: '#1C1C1C',
          borderWidth: 4,
          pointBackgroundColor: '#FFFFFF',
          pointBorderColor: '#1C1C1C',
          pointBorderWidth: 3,
          pointRadius: 0,
          pointHoverRadius: 8,
          fill: true,
          backgroundColor: 'rgba(28, 28, 28, 0.03)',
          tension: 0.5
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: {
            grid: { color: 'rgba(0,0,0,0.03)', drawBorder: false },
            ticks: { color: '#888888', font: { size: 10, weight: 600 }, callback: v => '₹' + v + 'k' }
          },
          x: { grid: { display: false }, ticks: { color: '#888888', font: { size: 10, weight: 600 } } }
        }
      }
    });

    // Growth Comparison Chart (Bar)
    const growthCtx = document.getElementById('growthChart').getContext('2d');
    new Chart(growthCtx, {
      type: 'bar',
      data: {
        labels: ['Previous Period', 'Current Period'],
        datasets: [{
          data: [12000, 4083],
          backgroundColor: ['rgba(255,255,255,0.1)', '#FFFFFF'],
          borderRadius: 12,
          barThickness: 60
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false }, ticks: { color: '#888888', font: { size: 9 } } },
          x: { grid: { display: false }, ticks: { color: '#FFFFFF', font: { size: 10, weight: 700 } } }
        }
      }
    });
  </script>
</body>
</html>
