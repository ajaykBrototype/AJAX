<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Sales Report — AJAX Admin</title>

<!-- FONTS -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          serif: ['Playfair Display', 'serif'],
          sans: ['Outfit', 'sans-serif']
        },
        colors: {
          brand: {
            dark: '#1C1C1C',
            muted: '#888888',
            border: 'rgba(0,0,0,0.06)',
            bg: '#FAFAF8'
          }
        }
      }
    }
  }
</script>

<style>
  body { 
    background: #FAFAF8; 
    color: #1C1C1C; 
    font-family: 'Outfit', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .editorial-title { font-family: 'Playfair Display', serif; }
  
  .glass-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.04);
    box-shadow: 0 4px 30px rgba(0,0,0,0.02);
    border-radius: 28px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8F8F6;
    color: #1C1C1C;
    border: 1px solid rgba(0,0,0,0.05);
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #E5E5E5; border-radius: 10px; }

  @keyframes slideInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-up { animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }

  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
  .delay-3 { animation-delay: 0.3s; }
  .delay-4 { animation-delay: 0.4s; }

  .modern-table th {
    padding: 16px 24px;
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #888888;
    border-bottom: 1px solid rgba(0,0,0,0.04);
  }
  .modern-table td {
    padding: 20px 24px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1C1C1C;
    border-bottom: 1px solid rgba(0,0,0,0.02);
  }
  .modern-table tr:last-child td { border-bottom: none; }
</style>
</head>
<body class="flex min-h-screen overflow-x-hidden">

  <!-- SIDEBAR (PARTIAL) -->
  <%- include('partials/sidebar', { currentPath: '/admin/sales-report' }) %>

  <!-- MAIN CONTENT -->
  <main class="flex-1 flex flex-col min-w-0">
    
    <!-- Top Nav / Header -->
    <header class="bg-white/80 backdrop-blur-md border-b border-brand-border px-10 py-8 sticky top-0 z-50">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="editorial-title text-4xl italic tracking-tight mb-2">Sales <span class="not-italic font-black text-brand-dark">Report</span></h1>
          <p class="text-[0.7rem] font-bold text-brand-muted uppercase tracking-[0.2em]">
            Performance overview <span class="mx-2 text-stone-300">•</span> <%= startDate %> — <%= endDate %>
          </p>
        </div>
        
        <div class="flex items-center gap-4">
          <!-- Time Period Selector (Custom Modern Dropdown) -->
          <div class="relative group" id="periodDropdown">
            <button id="dropdownBtn" class="flex items-center gap-4 pl-6 pr-5 py-3 bg-white border border-brand-border text-brand-dark rounded-full text-[0.7rem] font-black uppercase tracking-widest hover:border-brand-dark transition-all active:scale-95">
              <span id="selectedPeriodText"><%= period.charAt(0).toUpperCase() + period.slice(1) %></span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="ml-2 transition-transform duration-300" id="dropdownArrow"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div id="dropdownMenu" class="absolute right-0 mt-3 w-56 bg-white border border-brand-border rounded-[28px] shadow-[0_20px_50px_rgba(0,0,0,0.1)] py-3 opacity-0 invisible translate-y-4 transition-all duration-300 z-[100] overflow-hidden backdrop-blur-xl bg-white/95">
              <div class="px-5 py-2 text-[0.55rem] font-black text-brand-muted uppercase tracking-[0.2em] border-b border-brand-border/50 mb-2">Analysis Period</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" onclick="window.location.href='/admin/sales-report?period=day'">Day</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" onclick="window.location.href='/admin/sales-report?period=week'">Week</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" onclick="window.location.href='/admin/sales-report?period=month'">Month</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" onclick="window.location.href='/admin/sales-report?period=year'">Year</div>
            </div>
          </div>

          <!-- Export Button Dropdown -->
          <div class="relative group" id="exportDropdown">
            <button id="exportDropdownBtn" class="flex items-center gap-3 pl-6 pr-5 py-3 bg-brand-dark text-white rounded-full text-[0.7rem] font-black uppercase tracking-widest hover:bg-black transition-all shadow-xl shadow-black/10 active:scale-95">
              Export
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-300" id="exportDropdownArrow"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div id="exportDropdownMenu" class="absolute right-0 mt-3 w-56 bg-white border border-brand-border rounded-[28px] shadow-[0_20px_50px_rgba(0,0,0,0.1)] py-3 opacity-0 invisible translate-y-4 transition-all duration-300 z-[100] overflow-hidden backdrop-blur-xl bg-white/95">
              <div class="px-5 py-2 text-[0.55rem] font-black text-brand-muted uppercase tracking-[0.2em] border-b border-brand-border/50 mb-2">Export Format</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" onclick="window.location.href='/admin/sales-report?period=<%= period %>&download=excel'">Excel (.xlsx)</div>
              <div class="dropdown-item px-6 py-3.5 text-[0.7rem] font-bold text-brand-dark hover:bg-brand-bg cursor-pointer transition-all" onclick="window.location.href='/admin/sales-report?period=<%= period %>&download=pdf'">PDF Document</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="p-10 space-y-10">
      
      <!-- Top Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Revenue -->
        <% 
           let revGrowth = 0;
           if (previousStats.revenue > 0) {
             revGrowth = ((stats.revenue - previousStats.revenue) / previousStats.revenue) * 100;
           }
        %>
        <div class="glass-card p-8 animate-slide-up">
          <div class="flex justify-between items-start mb-8">
            <div class="stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="flex flex-col items-end">
              <span class="text-[0.6rem] font-black <%= revGrowth >= 0 ? 'text-emerald-500 bg-emerald-50' : 'text-rose-500 bg-rose-50' %> px-2 py-1 rounded-lg uppercase tracking-tighter mb-1">
                <%= revGrowth >= 0 ? '+' : '' %><%= revGrowth.toFixed(2) %>%
              </span>
              <span class="text-[0.5rem] font-bold text-brand-muted uppercase tracking-widest">vs prev. period</span>
            </div>
          </div>
          <p class="text-[0.65rem] font-bold text-brand-muted uppercase tracking-[0.2em] mb-2">Total Revenue</p>
          <h3 class="text-4xl font-black tracking-tighter">₹<%= stats.revenue.toLocaleString() %></h3>
        </div>

        <!-- Orders -->
        <div class="glass-card p-8 animate-slide-up delay-1">
          <div class="flex justify-between items-start mb-8">
            <div class="stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </div>
          </div>
          <p class="text-[0.65rem] font-bold text-brand-muted uppercase tracking-[0.2em] mb-2">Total Orders</p>
          <div class="flex items-baseline gap-3">
            <h3 class="text-4xl font-black tracking-tighter text-brand-dark"><%= stats.orderCount %></h3>
            <span class="text-[0.6rem] font-bold text-brand-muted uppercase tracking-widest">Active transactions</span>
          </div>
        </div>

        <!-- Products Sold -->
        <div class="glass-card p-8 animate-slide-up delay-2">
          <div class="flex justify-between items-start mb-8">
            <div class="stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
          </div>
          <p class="text-[0.65rem] font-bold text-brand-muted uppercase tracking-[0.2em] mb-2">Products Sold</p>
          <div class="flex items-baseline gap-3">
            <h3 class="text-4xl font-black tracking-tighter text-brand-dark"><%= stats.productCount %></h3>
            <span class="text-[0.6rem] font-bold text-brand-muted uppercase tracking-widest">Total units dispatched</span>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        <!-- Revenue Overview Chart -->
        <div class="lg:col-span-2 glass-card p-8 animate-slide-up delay-3 flex flex-col">
          <div class="flex items-center justify-between mb-10">
            <div>
              <h4 class="text-xl font-black tracking-tight mb-1">Revenue Overview</h4>
              <p class="text-[0.6rem] text-brand-muted font-bold uppercase tracking-widest">Daily sales peaks • <%= startDate %> — <%= endDate %></p>
            </div>
            <div class="text-right">
              <h3 class="text-2xl font-black tracking-tighter text-brand-dark">₹<%= stats.revenue.toLocaleString() %></h3>
              <span class="text-[0.6rem] font-black <%= revGrowth >= 0 ? 'text-emerald-500 bg-emerald-50' : 'text-rose-500 bg-rose-50' %> px-2 py-0.5 rounded-md uppercase">
                <%= revGrowth >= 0 ? '+' : '' %><%= revGrowth.toFixed(2) %>%
              </span>
            </div>
          </div>
          <div class="flex-1 min-h-[350px]">
            <canvas id="revenueChart"></canvas>
          </div>
        </div>

        <!-- Growth Comparison -->
        <div class="lg:col-span-1 glass-card p-8 animate-slide-up delay-3 flex flex-col bg-brand-dark text-white border-none shadow-2xl">
          <h4 class="text-xl font-black tracking-tight mb-1">Growth Comparison</h4>
          <p class="text-[0.6rem] text-stone-400 font-bold uppercase tracking-widest mb-10">Current vs Previous Period</p>
          
          <div class="flex-1 flex flex-col justify-center gap-12">
            <div class="flex-1 min-h-[250px]">
               <canvas id="growthChart"></canvas>
            </div>
            <div class="text-center pt-6 border-t border-white/10">
              <p class="text-[0.55rem] font-black uppercase tracking-[0.3em] text-stone-500 mb-2">Analysis Result</p>
              <p class="text-sm font-bold <%= revGrowth >= 0 ? 'text-emerald-400' : 'text-rose-400' %> italic">
                <%= revGrowth >= 0 ? '"Significant growth in realized revenue compared to last cycle."' : '"Moderate decline in realized revenue compared to last cycle."' %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Tables -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pb-10">
        <!-- Coupon Usage Details -->
        <div class="glass-card overflow-hidden animate-slide-up delay-4">
          <div class="p-8 border-b border-brand-border">
            <h4 class="text-xl font-black tracking-tight">Coupon Usage Details</h4>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full modern-table">
              <thead>
                <tr class="bg-brand-bg/50">
                  <th>Coupon Code</th>
                  <th class="text-center">Usage Count</th>
                  <th class="text-right">Total Discount</th>
                </tr>
              </thead>
              <tbody>
                <% if (couponUsage.length > 0) { %>
                  <% couponUsage.forEach(coupon => { %>
                    <tr>
                      <td>
                        <span class="bg-brand-bg text-brand-dark px-3 py-1 rounded-full text-[0.6rem] font-black uppercase tracking-widest border border-brand-border"><%= coupon._id %></span>
                      </td>
                      <td class="text-center text-brand-dark font-black"><%= coupon.count %>x</td>
                      <td class="text-right text-brand-dark font-black">₹<%= coupon.discount.toLocaleString() %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="text-center text-brand-muted py-10 font-bold uppercase tracking-widest">No coupon data for this period</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Order Discount Breakdown -->
        <div class="glass-card overflow-hidden animate-slide-up delay-4">
          <div class="p-8 border-b border-brand-border flex justify-between items-center">
            <h4 class="text-xl font-black tracking-tight">Recent Orders</h4>
            <div class="bg-brand-dark text-white px-4 py-1.5 rounded-full text-[0.6rem] font-black uppercase tracking-widest">
              Visible: <%= orderBreakdown.length %>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full modern-table">
              <thead>
                <tr class="bg-brand-bg/50">
                  <th>Order #</th>
                  <th>Date</th>
                  <th>Subtotal</th>
                  <th>Discount</th>
                  <th class="text-right">Final</th>
                </tr>
              </thead>
              <tbody>
                <% if (orderBreakdown.length > 0) { %>
                  <% orderBreakdown.forEach(order => { %>
                    <tr>
                      <td class="font-bold text-[0.7rem] text-brand-dark tracking-tighter">#<%= order._id.toString().slice(-8).toUpperCase() %></td>
                      <td class="text-brand-muted text-[0.65rem]"><%= order.createdAt.toLocaleDateString() %></td>
                      <td class="text-brand-dark">₹<%= (order.totalAmount + order.discount).toLocaleString() %></td>
                      <td class="text-rose-500 font-bold"><%= order.discount > 0 ? '- ₹'+order.discount : '—' %></td>
                      <td class="text-right font-black text-brand-dark">₹<%= order.totalAmount.toLocaleString() %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                   <tr>
                    <td colspan="5" class="text-center text-brand-muted py-10 font-bold uppercase tracking-widest">No order data for this period</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    // Custom Dropdown Logic
    const dropdownBtn = document.getElementById('dropdownBtn');
    const dropdownMenu = document.getElementById('dropdownMenu');
    const dropdownArrow = document.getElementById('dropdownArrow');

    const exportDropdownBtn = document.getElementById('exportDropdownBtn');
    const exportDropdownMenu = document.getElementById('exportDropdownMenu');
    const exportDropdownArrow = document.getElementById('exportDropdownArrow');

    if (dropdownBtn) {
      dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (exportDropdownMenu) {
          exportDropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
          exportDropdownArrow.classList.remove('rotate-180');
        }
        const isOpen = !dropdownMenu.classList.contains('invisible');
        if (isOpen) {
          dropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
          dropdownArrow.classList.remove('rotate-180');
        } else {
          dropdownMenu.classList.remove('opacity-0', 'invisible', 'translate-y-4');
          dropdownArrow.classList.add('rotate-180');
        }
      });
    }

    if (exportDropdownBtn) {
      exportDropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dropdownMenu) {
          dropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
          dropdownArrow.classList.remove('rotate-180');
        }
        const isOpen = !exportDropdownMenu.classList.contains('invisible');
        if (isOpen) {
          exportDropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
          exportDropdownArrow.classList.remove('rotate-180');
        } else {
          exportDropdownMenu.classList.remove('opacity-0', 'invisible', 'translate-y-4');
          exportDropdownArrow.classList.add('rotate-180');
        }
      });
    }

    document.addEventListener('click', () => {
      if (dropdownMenu) {
        dropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
        dropdownArrow.classList.remove('rotate-180');
      }
      if (exportDropdownMenu) {
        exportDropdownMenu.classList.add('opacity-0', 'invisible', 'translate-y-4');
        exportDropdownArrow.classList.remove('rotate-180');
      }
    });

    // Revenue Chart (Line)
    const revCtx = document.getElementById('revenueChart').getContext('2d');
    const overviewData = <%- JSON.stringify(revenueOverview) %>;
    
    new Chart(revCtx, {
      type: 'line',
      data: {
        labels: overviewData.map(d => d._id),
        datasets: [{
          label: 'Net Revenue',
          data: overviewData.map(d => d.revenue),
          borderColor: '#1C1C1C',
          borderWidth: 4,
          pointBackgroundColor: '#FFFFFF',
          pointBorderColor: '#1C1C1C',
          pointBorderWidth: 3,
          pointRadius: 4,
          pointHoverRadius: 8,
          fill: true,
          backgroundColor: 'rgba(28, 28, 28, 0.03)',
          tension: 0.5
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: {
            grid: { color: 'rgba(0,0,0,0.03)', drawBorder: false },
            ticks: { color: '#888888', font: { size: 10, weight: 600 }, callback: v => '₹' + v.toLocaleString() }
          },
          x: { grid: { display: false }, ticks: { color: '#888888', font: { size: 10, weight: 600 } } }
        }
      }
    });

    // Growth Comparison Chart (Bar)
    const growthCtx = document.getElementById('growthChart').getContext('2d');
    new Chart(growthCtx, {
      type: 'bar',
      data: {
        labels: ['Previous Period', 'Current Period'],
        datasets: [{
          data: [<%= previousStats.revenue %>, <%= stats.revenue %>],
          backgroundColor: ['rgba(255,255,255,0.1)', '#FFFFFF'],
          borderRadius: 12,
          barThickness: 60
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false }, ticks: { color: '#888888', font: { size: 9 } } },
          x: { grid: { display: false }, ticks: { color: '#FFFFFF', font: { size: 10, weight: 700 } } }
        }
      }
    });
  </script>
</body>
</html>
